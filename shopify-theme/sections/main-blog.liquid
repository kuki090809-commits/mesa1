<section class="simple-page">
  <div class="container">
    <h1>{{ blog.title }}</h1>
    <div class="article-list">
      {%- for article in blog.articles -%}
        <a href="{{ article.url }}" class="article-card">
          {%- if article.image -%}<img src="{{ article.image | image_url: width: 500 }}" alt="{{ article.title | escape }}" width="500" height="{{ 500 | divided_by: article.image.aspect_ratio | default: 500 }}" loading="lazy">{%- endif -%}
          <h2>{{ article.title }}</h2>
          <p>{{ article.excerpt_or_content | strip_html | truncate: 120 }}</p>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>
{% schema %}{ "name": "Blog", "settings": [] }{% endschema %}
