<footer class="site-footer">
  <div class="container site-footer__grid">
    <div class="site-footer__brand">
      <span class="site-footer__logo">{{ shop.name }}</span>
      {%- if section.settings.tagline != blank -%}<p>{{ section.settings.tagline }}</p>{%- endif -%}
    </div>

    {%- for block in section.blocks -%}
      {%- if block.type == 'link_column' -%}
        <div class="site-footer__column" {{ block.shopify_attributes }}>
          <h3>{{ block.settings.heading }}</h3>
          <ul>
            {%- for link in block.settings.menu.links -%}
              <li><a href="{{ link.url }}">{{ link.title }}</a></li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    {%- endfor -%}

    <div class="site-footer__contact">
      {%- if section.settings.contact_email != blank -%}
        <a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_email }}</a>
      {%- endif -%}
      {% render 'payment-icons' %}
    </div>
  </div>

  <div class="site-footer__bottom container">
    <p>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}. {{ section.settings.bottom_text }}</p>
  </div>
</footer>

{% schema %}
{
  "name": "Pie de página",
  "settings": [
    { "type": "text", "id": "tagline", "label": "Eslogan", "default": "Cocina de precisión, sin complicarte." },
    { "type": "text", "id": "contact_email", "label": "Email de contacto" },
    { "type": "text", "id": "bottom_text", "label": "Texto legal inferior", "default": "Todos los derechos reservados." }
  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Columna de enlaces",
      "settings": [
        { "type": "text", "id": "heading", "label": "Título", "default": "Tienda" },
        { "type": "link_list", "id": "menu", "label": "Menú", "default": "footer" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Pie de página",
      "blocks": [
        { "type": "link_column", "settings": { "heading": "Tienda" } },
        { "type": "link_column", "settings": { "heading": "Ayuda" } }
      ]
    }
  ]
}
{% endschema %}
