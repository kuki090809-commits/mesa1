<section class="simple-page">
  <div class="container">
    <h1>{{ collection.title }}</h1>
    {%- if collection.description != blank -%}<div class="rich-text">{{ collection.description }}</div>{%- endif -%}

    {%- paginate collection.products by 24 -%}
      {%- if collection.products.size == 0 -%}
        <p>Todavía no hay productos en esta colección.</p>
      {%- else -%}
        <div class="product-grid">
          {%- for product in collection.products -%}
            {% render 'product-card', product: product %}
          {%- endfor -%}
        </div>
        {%- if paginate.pages > 1 -%}
          <nav class="pagination">{{ paginate | default_pagination }}</nav>
        {%- endif -%}
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>
{% schema %}{ "name": "Colección", "settings": [] }{% endschema %}
