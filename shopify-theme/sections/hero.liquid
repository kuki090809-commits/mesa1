<section class="hero">
  <div class="container hero__grid">
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
      <h1 class="hero__heading">{{ section.settings.heading }}</h1>
      {%- if section.settings.text != blank -%}<div class="hero__text">{{ section.settings.text }}</div>{%- endif -%}

      <div class="hero__actions">
        {%- if section.settings.button_label != blank -%}
          <a href="{{ section.settings.button_link | default: '#' }}" class="btn btn--solid">{{ section.settings.button_label }} &rarr;</a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn--outline">{{ section.settings.button_label_2 }}</a>
        {%- endif -%}
      </div>

      {%- if section.settings.rating_value > 0 -%}
        <div class="hero__rating">
          <span class="hero__stars" aria-hidden="true">
            {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
          </span>
          <span>{{ section.settings.rating_value }}/5{%- if section.settings.rating_count > 0 %} &middot; {{ section.settings.rating_count }} opiniones verificadas{% endif -%}</span>
        </div>
      {%- endif -%}
    </div>

    <div class="hero__media">
      {%- if section.settings.image -%}
        <img
          src="{{ section.settings.image | image_url: width: 1200 }}"
          srcset="{{ section.settings.image | image_url: width: 600 }} 600w, {{ section.settings.image | image_url: width: 1200 }} 1200w"
          sizes="(min-width: 990px) 50vw, 100vw"
          alt="{{ section.settings.image.alt | default: section.settings.heading | escape }}"
          width="{{ section.settings.image.width }}"
          height="{{ section.settings.image.height }}"
          loading="eager"
        >
      {%- endif -%}

      {%- if section.settings.badge_text != blank -%}
        <span class="hero__badge">{{ section.settings.badge_text }}</span>
      {%- endif -%}

      {%- if section.settings.featured_product != blank -%}
        <div class="hero__price-card">
          <span class="hero__price-card-label">{{ section.settings.price_card_label | default: 'Precio de lanzamiento' }}</span>
          {% render 'price', target: section.settings.featured_product %}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "— MEDIDA EXACTA" },
    { "type": "text", "id": "heading", "label": "Titular", "default": "MIDE EXACTO. SIRVE SIN GOTEO." },
    { "type": "richtext", "id": "text", "label": "Texto", "default": "<p>Gira el mando y ajusta el volumen exacto hasta 250 ml. Doble escala para no fallar nunca, pico vertedor para servir sin goteo.</p>" },
    { "type": "text", "id": "button_label", "label": "Botón principal", "default": "Comprar ahora" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón principal" },
    { "type": "text", "id": "button_label_2", "label": "Botón secundario", "default": "Ver características" },
    { "type": "url", "id": "button_link_2", "label": "Enlace del botón secundario" },
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "badge_text", "label": "Distintivo sobre la imagen", "default": "Envío en 48 h" },
    { "type": "product", "id": "featured_product", "label": "Producto para la tarjeta de precio" },
    { "type": "text", "id": "price_card_label", "label": "Texto de la tarjeta de precio", "default": "Precio de lanzamiento" },
    { "type": "range", "id": "rating_value", "label": "Valoración (0 = ocultar)", "min": 0, "max": 5, "step": 0.1, "default": 0 },
    { "type": "number", "id": "rating_count", "label": "Número de opiniones", "default": 0 }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
