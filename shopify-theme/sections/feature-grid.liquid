<section class="feature-grid">
  <div class="container">
    <div class="feature-grid__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>

    <div class="feature-grid__list">
      {%- for block in section.blocks -%}
        <div class="feature-card" {{ block.shopify_attributes }}>
          <div class="feature-card__media">
            {%- if block.settings.image -%}
              <img src="{{ block.settings.image | image_url: width: 500 }}" alt="{{ block.settings.title | escape }}" width="500" height="{{ 500 | divided_by: block.settings.image.aspect_ratio | default: 500 }}" loading="lazy">
            {%- endif -%}
            <span class="feature-card__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            {%- if block.settings.tag != blank -%}<span class="feature-card__tag">{{ block.settings.tag }}</span>{%- endif -%}
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Cuadrícula de beneficios",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "TODO LO QUE NECESITAS PARA MEDIR BIEN." },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Una sola pieza para el agua, la harina, la miel y todo lo que viene entre medias." }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Beneficio",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "tag", "label": "Distintivo sobre la imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Medida exacta" },
        { "type": "textarea", "id": "text", "label": "Descripción", "default": "Gira el mando y ajusta el volumen exacto, de 50 a 250 ml." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Cuadrícula de beneficios",
      "blocks": [
        { "type": "feature", "settings": { "tag": "DE 50 A 250 ML", "title": "MEDIDA EXACTA EN UN GIRO", "text": "Ajusta el volumen exacto girando el mando del asa, sin cambiar de pieza." } },
        { "type": "feature", "settings": { "tag": "PICO VERTEDOR", "title": "SIRVE SIN GOTEO", "text": "Vierte líquidos con precisión, sin manchar la encimera." } },
        { "type": "feature", "settings": { "tag": "ML A LA VISTA", "title": "DOBLE ESCALA", "text": "Medidas en ml visibles desde cualquier ángulo, sin confusiones." } },
        { "type": "feature", "settings": { "tag": "1 SOLA PIEZA", "title": "APTA LAVAVAJILLAS", "text": "Sustituye varias tazas sueltas y se limpia en segundos." } }
      ]
    }
  ]
}
{% endschema %}
