{%- assign current_variant = product.selected_or_first_available_variant -%}
{%- capture variant_data -%}
[
  {%- for variant in product.variants -%}
    {
      "id": {{ variant.id }},
      "price": {{ variant.price | money | json }},
      "compare_at": {% if variant.compare_at_price and variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %},
      "available": {{ variant.available }},
      "options": {{ variant.options | json }}
    }{% unless forloop.last %},{% endunless %}
  {%- endfor -%}
]
{%- endcapture -%}

<section class="product-section">
  <div class="container product-section__grid">
    <div class="product-gallery">
      <div class="product-gallery__main">
        {%- if section.settings.badge_text != blank -%}<span class="featured-product__badge">{{ section.settings.badge_text }}</span>{%- endif -%}
        {%- if product.featured_image -%}
          <img id="ProductMainImage" src="{{ product.featured_image | image_url: width: 1000 }}" alt="{{ product.featured_image.alt | default: product.title | escape }}" width="1000" height="{{ 1000 | divided_by: product.featured_image.aspect_ratio | default: 1000 }}">
        {%- endif -%}
      </div>
      {%- if product.images.size > 1 -%}
        <div class="product-gallery__thumbs">
          {%- for image in product.images -%}
            <button type="button" class="product-gallery__thumb" data-full-src="{{ image | image_url: width: 1000 }}">
              <img src="{{ image | image_url: width: 200 }}" alt="{{ image.alt | default: product.title | escape }}" width="200" height="{{ 200 | divided_by: image.aspect_ratio | default: 200 }}" loading="lazy">
            </button>
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>

    <div class="product-info">
      {%- if product.vendor != blank -%}<p class="product-info__vendor">{{ product.vendor }}</p>{%- endif -%}
      <h1 class="product-info__title">{{ product.title }}</h1>

      {%- if section.settings.rating_value > 0 -%}
        <div class="rating">
          <span class="rating__stars" aria-hidden="true">{%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}</span>
          <span>{{ section.settings.rating_value }}/5 &middot; {{ section.settings.rating_count }} opiniones verificadas</span>
        </div>
      {%- endif -%}

      <div data-price-wrapper>{% render 'price', target: current_variant %}</div>
      {%- if current_variant.compare_at_price and current_variant.compare_at_price > current_variant.price -%}
        <p class="product-info__savings" data-savings-text>Ahorras {{ current_variant.compare_at_price | minus: current_variant.price | money }}</p>
      {%- endif -%}

      <div class="product-info__description">{{ product.description }}</div>

      {%- if section.blocks.size > 0 -%}
        <ul class="tag-pills">
          {%- for block in section.blocks -%}
            {%- if block.type == 'tag' -%}
              <li {{ block.shopify_attributes }}>{% render 'icon-check' %} {{ block.settings.text }}</li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- form 'product', product, id: 'ProductForm', class: 'product-form' -%}
        <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id-input>

        {%- for option in product.options_with_values -%}
          <fieldset class="product-form__option" data-option-index="{{ forloop.index0 }}">
            <legend>{{ option.name }}</legend>
            <div class="product-form__pills">
              {%- for value in option.values -%}
                <button type="button" class="pill-option{% if value == option.selected_value %} is-selected{% endif %}" data-option-value="{{ value | escape }}">{{ value }}</button>
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}

        <div class="product-form__availability">
          <span class="status-dot{% if current_variant.available == false %} is-unavailable{% endif %}" data-availability-dot></span>
          <span data-availability-text>
            {%- if current_variant.available -%}{{ section.settings.in_stock_text }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}
          </span>
        </div>

        <div class="product-form__buy-row">
          <div class="quantity-stepper">
            <button type="button" data-quantity-decrease aria-label="Reducir cantidad">&minus;</button>
            <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-quantity-input>
            <button type="button" data-quantity-increase aria-label="Aumentar cantidad">+</button>
          </div>
          <button type="submit" class="btn btn--solid" data-add-to-cart{% unless current_variant.available %} disabled{% endunless %}>
            {% render 'icon-cart' %}
            <span data-add-to-cart-text>{%- if current_variant.available -%}{{ 'products.product.add_to_cart' | t }}{%- else -%}{{ 'products.product.sold_out' | t }}{%- endif -%}</span>
          </button>
        </div>

        {{ form | payment_button }}

        <p class="product-form__note">{% render 'icon-truck' %} {{ section.settings.shipping_note }}</p>
      {%- endform -%}

      <div class="trust-grid">
        {%- for block in section.blocks -%}
          {%- if block.type == 'trust_item' -%}
            <div class="trust-grid__item" {{ block.shopify_attributes }}>
              {%- case block.settings.icon -%}
                {%- when 'shield' -%}{% render 'icon-shield' %}
                {%- when 'truck' -%}{% render 'icon-truck' %}
                {%- when 'return' -%}{% render 'icon-return' %}
                {%- when 'chat' -%}{% render 'icon-chat' %}
              {%- endcase -%}
              <span>{{ block.settings.text }}</span>
            </div>
          {%- endif -%}
        {%- endfor -%}
      </div>

      {% render 'payment-icons' %}

      <div class="accordions">
        <details class="accordion" open>
          <summary>
            <span>{{ 'products.product.description' | t }}</span>
            {% render 'icon-chevron' %}
          </summary>
          <div class="accordion__body">{{ product.description }}</div>
        </details>

        {%- for block in section.blocks -%}
          {%- if block.type == 'accordion' -%}
            <details class="accordion" {{ block.shopify_attributes }}>
              <summary>
                <span>{{ block.settings.title }}</span>
                {% render 'icon-plus' %}
              </summary>
              <div class="accordion__body">{{ block.settings.content }}</div>
            </details>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script type="application/json" data-variant-data>{{ variant_data }}</script>

{% schema %}
{
  "name": "Página de producto",
  "settings": [
    { "type": "text", "id": "badge_text", "label": "Distintivo sobre la imagen", "default": "Oferta de lanzamiento" },
    { "type": "range", "id": "rating_value", "label": "Valoración (0 = ocultar)", "min": 0, "max": 5, "step": 0.1, "default": 0 },
    { "type": "number", "id": "rating_count", "label": "Número de opiniones", "default": 0 },
    { "type": "text", "id": "in_stock_text", "label": "Texto de disponibilidad", "default": "En stock, se envía en 48 h" },
    { "type": "text", "id": "shipping_note", "label": "Nota de envío", "default": "Envío con seguimiento y devolución en 30 días." }
  ],
  "blocks": [
    {
      "type": "tag",
      "name": "Distintivo de check",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Apta lavavajillas" }]
    },
    {
      "type": "trust_item",
      "name": "Bloque de confianza",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icono",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Escudo (pago seguro)" },
            { "value": "truck", "label": "Camión (envío)" },
            { "value": "return", "label": "Devolución" },
            { "value": "chat", "label": "Chat (soporte)" }
          ]
        },
        { "type": "text", "id": "text", "label": "Texto", "default": "Pago 100% seguro" }
      ]
    },
    {
      "type": "accordion",
      "name": "Acordeón",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Envíos y devoluciones" },
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Envío con seguimiento incluido. El plazo exacto se muestra en el checkout. Devolución gratuita durante 30 días desde la recepción.</p>" }
      ]
    }
  ],
  "default": {
    "blocks": [
      { "type": "tag", "settings": { "text": "Diseño 4 en 1" } },
      { "type": "tag", "settings": { "text": "Pico vertedor" } },
      { "type": "tag", "settings": { "text": "Apta lavavajillas" } },
      { "type": "trust_item", "settings": { "icon": "shield", "text": "Pago 100% seguro" } },
      { "type": "trust_item", "settings": { "icon": "truck", "text": "Envío con seguimiento" } },
      { "type": "trust_item", "settings": { "icon": "return", "text": "30 días para cambiar de opinión" } },
      { "type": "trust_item", "settings": { "icon": "chat", "text": "Atención al cliente cercana" } },
      { "type": "accordion", "settings": { "title": "Cómo funciona" } },
      { "type": "accordion", "settings": { "title": "Envíos y devoluciones" } }
    ]
  }
}
{% endschema %}
