<section class="simple-page">
  <div class="container simple-page__center">
    <h1>{{ shop.name }}</h1>
    <p>{{ shop.password_message | default: 'Esta tienda estará disponible muy pronto.' }}</p>
    {%- form 'storefront_password' -%}
      <label for="Password">{{ 'general.password_page.login_form_password_label' | t }}</label>
      <input type="password" name="password" id="Password">
      {%- if form.errors -%}<p class="form-error">Contraseña incorrecta.</p>{%- endif -%}
      <button type="submit" class="btn btn--solid">{{ 'general.password_page.login_form_submit' | t }}</button>
    {%- endform -%}
  </div>
</section>
{% schema %}{ "name": "Contraseña", "settings": [] }{% endschema %}
