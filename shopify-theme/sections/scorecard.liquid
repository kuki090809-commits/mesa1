<section class="scorecard">
  <div class="container">
    <div class="scorecard__head">
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subheading != blank -%}<p>{{ section.settings.subheading }}</p>{%- endif -%}
    </div>
    <div class="scorecard__grid">
      {%- for block in section.blocks -%}
        <div class="scorecard__tile" {{ block.shopify_attributes }}>
          <span class="scorecard__value">{{ block.settings.value }}</span>
          <span class="scorecard__caption">{{ block.settings.caption }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Scorecard",
  "settings": [
    { "type": "text", "id": "heading", "label": "Título", "default": "LA FICHA TÉCNICA." },
    { "type": "text", "id": "subheading", "label": "Subtítulo", "default": "Los datos que puedes comprobar antes de comprar." }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Dato",
      "settings": [
        { "type": "text", "id": "value", "label": "Valor", "default": "250ml" },
        { "type": "text", "id": "caption", "label": "Descripción", "default": "Capacidad máxima" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Scorecard",
      "blocks": [
        { "type": "stat", "settings": { "value": "250ml", "caption": "Capacidad máxima" } },
        { "type": "stat", "settings": { "value": "50-250", "caption": "Rango ajustable en ml" } },
        { "type": "stat", "settings": { "value": "1 pieza", "caption": "Sustituye varias tazas" } },
        { "type": "stat", "settings": { "value": "30 días", "caption": "Para devoluciones" } }
      ]
    }
  ]
}
{% endschema %}
