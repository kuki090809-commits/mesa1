{%- comment -%} Usage: {% render 'product-card', product: product %} {%- endcomment -%}
<a href="{{ product.url }}" class="product-card">
  <span class="product-card__media">
    {%- if product.featured_image -%}
      <img
        src="{{ product.featured_image | image_url: width: 600 }}"
        alt="{{ product.featured_image.alt | default: product.title | escape }}"
        width="600"
        height="{{ 600 | divided_by: product.featured_image.aspect_ratio | default: 600 }}"
        loading="lazy"
      >
    {%- else -%}
      <span class="product-card__placeholder">{{ product.title | slice: 0, 1 }}</span>
    {%- endif -%}
  </span>
  <span class="product-card__title">{{ product.title }}</span>
  {% render 'price', target: product %}
</a>
