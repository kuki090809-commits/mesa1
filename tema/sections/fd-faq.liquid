{%- assign titulo_min = section.settings.titulo_tam | times: 0.6 | round -%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--fd-fondo-alt)' }};
  }
  #shopify-section-{{ section.id }} .fd-faq { background: transparent; --fd-faq-tam: {{ section.settings.pregunta_tam }}px; }
  #shopify-section-{{ section.id }} .fd-h2 { font-size: clamp({{ titulo_min }}px, 5vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .fd-faq__intro { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .fd-faq__respuesta { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<section class="fd-section fd-faq" aria-label="{{ section.settings.titulo | strip_html | escape }}">
  <div class="fd-container">
    <div class="fd-faq__grid">
      <div class="fd-faq__intro">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fd-eyebrow fd-reveal">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="fd-h2 fd-reveal" style="--fd-i: 1">{{ section.settings.titulo }}</h2>
        {%- if section.settings.texto != blank -%}
          <p class="fd-body fd-reveal" style="--fd-i: 2">{{ section.settings.texto | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.boton_texto != blank -%}
          <a class="fd-btn fd-btn--linea fd-reveal" style="--fd-i: 3" href="{{ section.settings.boton_enlace | default: '/pages/contacto' }}">{{ section.settings.boton_texto | escape }}</a>
        {%- endif -%}
      </div>
      <div class="fd-faq__lista">
        {%- for block in section.blocks -%}
          <details class="fd-faq__item fd-reveal" style="--fd-i: {{ forloop.index }}"{% if forloop.first and section.settings.abrir_primera %} open{% endif %} {{ block.shopify_attributes }}>
            <summary>
              <span>{{ block.settings.pregunta | escape }}</span>
              <span class="fd-faq__icono" aria-hidden="true"></span>
            </summary>
            <div class="fd-faq__respuesta">{{ block.settings.respuesta }}</div>
          </details>
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{%- if section.settings.datos_google and section.blocks.size > 0 -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "FAQPage",
      "mainEntity": [
        {%- for block in section.blocks -%}
          {
            "@type": "Question",
            "name": {{ block.settings.pregunta | json }},
            "acceptedAnswer": { "@type": "Answer", "text": {{ block.settings.respuesta | strip_html | json }} }
          }{% unless forloop.last %},{% endunless %}
        {%- endfor -%}
      ]
    }
  </script>
{%- endif -%}

{% schema %}
{
  "name": "FlexiDesk – Preguntas",
  "tag": "div",
  "class": "fd-wrap",
  "max_blocks": 16,
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Preguntas frecuentes" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Lo que suelen <em>preguntarnos.</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "¿No encuentras tu respuesta? Escríbenos y te contestamos encantados." },
    { "type": "text", "id": "boton_texto", "label": "Botón: texto", "default": "Contactar" },
    { "type": "url", "id": "boton_enlace", "label": "Botón: enlace", "info": "Vacío = página de contacto." },
    { "type": "checkbox", "id": "abrir_primera", "label": "Primera pregunta abierta", "default": true },
    { "type": "checkbox", "id": "datos_google", "label": "Mostrar estas preguntas a Google (resultados enriquecidos)", "default": true },
    { "type": "header", "content": "Tipografía y color" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 50 },
    { "type": "range", "id": "pregunta_tam", "label": "Tamaño de las preguntas (px)", "min": 16, "max": 32, "step": 1, "unit": "px", "default": 22 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño de las respuestas (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "alineacion", "label": "Alineación de la introducción", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo secundario de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "pregunta",
      "name": "Pregunta",
      "settings": [
        { "type": "text", "id": "pregunta", "label": "Pregunta", "default": "¿Entre qué alturas se regula?" },
        { "type": "richtext", "id": "respuesta", "label": "Respuesta", "default": "<p>De 60 a 90 cm, para adaptarse a tu posición.</p>" }
      ]
    }
  ],
  "presets": [
    {
      "name": "FlexiDesk – Preguntas",
      "blocks": [
        { "type": "pregunta" }
      ]
    }
  ]
}
{% endschema %}
