{%- liquid
  assign titulo_min = section.settings.titulo_tam | times: 0.6 | round
  assign a_min = section.settings.alt_min
  assign a_max = section.settings.alt_max
  if a_max <= a_min
    assign a_max = a_min | plus: 30
  endif
  assign a_ini = section.settings.alt_inicial
  if a_ini < a_min or a_ini > a_max
    assign a_ini = a_min
  endif
  assign rango = a_max | minus: a_min
  assign dy = a_ini | minus: a_min | times: 135.0 | divided_by: rango | times: -1 | round: 1
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--fd-fondo)' }};
  }
  #shopify-section-{{ section.id }} .fd-h2 { font-size: clamp({{ titulo_min }}px, 5vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .fd-altura__texto { text-align: {{ section.settings.alineacion }}; }
  #shopify-section-{{ section.id }} .fd-body { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<section id="{{ section.settings.ancla | default: 'altura' | handleize }}" class="fd-section fd-altura" aria-label="{{ section.settings.titulo | strip_html | escape }}">
  <div class="fd-container">
    <div
      class="fd-altura__grid"
      data-fd-altura
      data-min="{{ a_min }}"
      data-max="{{ a_max }}"
      data-umbral1="{{ section.settings.umbral1 }}"
      data-umbral2="{{ section.settings.umbral2 }}"
    >
      <div class="fd-altura__texto">
        {%- if section.settings.eyebrow != blank -%}
          <p class="fd-eyebrow fd-reveal">{{ section.settings.eyebrow }}</p>
        {%- endif -%}
        <h2 class="fd-h2 fd-reveal" style="--fd-i: 1">{{ section.settings.titulo }}</h2>
        {%- if section.settings.texto != blank -%}
          <p class="fd-body fd-reveal" style="--fd-i: 2">{{ section.settings.texto | newline_to_br }}</p>
        {%- endif -%}

        <div class="fd-altura__panel fd-reveal" style="--fd-i: 3">
          <p class="fd-altura__lectura" aria-live="polite"><span data-fd-cm>{{ a_ini }}</span><small>cm</small></p>
          <p class="fd-altura__pista">
            <span data-fd-pista="1"{% if a_ini >= section.settings.umbral1 %} hidden{% endif %}>{{ section.settings.pista_baja | escape }}</span>
            <span data-fd-pista="2"{% if a_ini < section.settings.umbral1 or a_ini >= section.settings.umbral2 %} hidden{% endif %}>{{ section.settings.pista_media | escape }}</span>
            <span data-fd-pista="3"{% if a_ini < section.settings.umbral2 %} hidden{% endif %}>{{ section.settings.pista_alta | escape }}</span>
          </p>
          <input class="fd-altura__rango" type="range" min="{{ a_min }}" max="{{ a_max }}" step="1" value="{{ a_ini }}" aria-label="{{ section.settings.etiqueta_rango | escape }}">
          <div class="fd-altura__limites" aria-hidden="true"><span>{{ a_min }} cm</span><span>{{ a_max }} cm</span></div>
        </div>
      </div>

      <div class="fd-altura__visual fd-reveal" style="--fd-i: 1">
        <svg class="fd-altura__svg" viewBox="0 0 520 620" role="img" aria-label="La mesa sube y baja con el deslizador">
          <rect x="0" y="0" width="520" height="620" rx="0" style="fill:var(--fd-fondo-alt)"/>
          <line x1="58" y1="572" x2="58" y2="130" style="stroke:var(--fd-texto);stroke-width:2;stroke-dasharray:4 8;opacity:.3"/>
          <rect x="0" y="572" width="520" height="48" style="fill:#D7D8D1"/>
          <rect x="0" y="570" width="520" height="4" style="fill:#C9CAC3"/>
          <rect x="150" y="544" width="260" height="14" rx="7" style="fill:#2A2D33"/>
          <rect x="256" y="532" width="48" height="16" rx="6" style="fill:#2A2D33"/>
          <circle cx="168" cy="562" r="12" style="fill:#17191D"/><circle cx="168" cy="562" r="4" style="fill:#8B95A5"/>
          <circle cx="392" cy="562" r="12" style="fill:#17191D"/><circle cx="392" cy="562" r="4" style="fill:#8B95A5"/>
          <g class="fd-altura__sube" style="--fd-dy: {{ dy }}px;">
            <rect x="271" y="322" width="18" height="210" style="fill:#5B616B"/>
            <rect x="230" y="314" width="100" height="10" rx="4" style="fill:#2A2D33"/>
            <polygon points="144,272 416,272 440,302 120,302" style="fill:#50555E"/>
            <rect x="120" y="302" width="320" height="12" rx="3" style="fill:#2E3238"/>
            <rect x="216" y="196" width="128" height="86" rx="6" style="fill:#C9CDD3"/>
            <rect x="223" y="203" width="114" height="72" rx="3" style="fill:#1E2638"/>
            <rect x="231" y="213" width="56" height="8" rx="4" style="fill:var(--fd-acento)"/>
            <rect x="231" y="227" width="90" height="5" rx="2.5" style="fill:#fff;opacity:.28"/>
            <rect x="231" y="237" width="68" height="5" rx="2.5" style="fill:#fff;opacity:.28"/>
            <polygon points="212,282 348,282 364,298 196,298" style="fill:#B7BCC4"/>
            <line x1="62" y1="308" x2="116" y2="308" style="stroke:var(--fd-acento);stroke-width:2;stroke-dasharray:3 5"/>
            <rect x="14" y="290" width="88" height="36" rx="18" style="fill:var(--fd-acento)"/>
            <text x="58" y="314" text-anchor="middle" class="fd-altura__etiqueta" data-fd-cm-svg>{{ a_ini }} cm</text>
          </g>
          <rect x="266" y="330" width="28" height="210" rx="5" style="fill:#2A2D33"/>
          <rect x="270" y="336" width="4" height="196" rx="2" style="fill:#fff;opacity:.14"/>
          <rect x="292" y="352" width="14" height="9" rx="3" style="fill:#17191D"/>
          <circle cx="310" cy="356.5" r="8" style="fill:#17191D"/>
        </svg>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "FlexiDesk – Altura",
  "tag": "div",
  "class": "fd-wrap",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Altura regulable" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Súbela, bájala. <em>Tú decides.</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Mueve el deslizador y mira cómo se adapta: de 60 a 90 cm para ajustarse a tu posición." },
    { "type": "text", "id": "etiqueta_rango", "label": "Texto del deslizador para lectores de pantalla", "default": "Elige la altura de la mesa" },
    { "type": "text", "id": "ancla", "label": "Nombre del ancla", "default": "altura" },
    { "type": "header", "content": "Alturas" },
    { "type": "range", "id": "alt_min", "label": "Altura mínima (cm)", "min": 40, "max": 90, "step": 1, "unit": "cm", "default": 60 },
    { "type": "range", "id": "alt_max", "label": "Altura máxima (cm)", "min": 60, "max": 130, "step": 1, "unit": "cm", "default": 90 },
    { "type": "range", "id": "alt_inicial", "label": "Altura al cargar (cm)", "min": 40, "max": 130, "step": 1, "unit": "cm", "default": 72 },
    { "type": "header", "content": "Consejos según la altura" },
    { "type": "text", "id": "pista_baja", "label": "Consejo para alturas bajas", "default": "Perfecta junto al sofá: el portátil, a mano." },
    { "type": "range", "id": "umbral1", "label": "A partir de esta altura, consejo medio (cm)", "min": 40, "max": 130, "step": 1, "unit": "cm", "default": 70 },
    { "type": "text", "id": "pista_media", "label": "Consejo para alturas medias", "default": "Ideal con el sillón o una silla para leer o estudiar." },
    { "type": "range", "id": "umbral2", "label": "A partir de esta altura, consejo alto (cm)", "min": 40, "max": 130, "step": 1, "unit": "cm", "default": 80 },
    { "type": "text", "id": "pista_alta", "label": "Consejo para alturas altas", "default": "Junto a la cama: trabaja o desayuna sin levantarte." },
    { "type": "header", "content": "Tipografía y color" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 56 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "select", "id": "alineacion", "label": "Alineación del texto", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo principal de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "presets": [ { "name": "FlexiDesk – Altura" } ]
}
{% endschema %}
