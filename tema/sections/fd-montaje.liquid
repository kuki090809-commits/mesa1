{%- assign titulo_min = section.settings.titulo_tam | times: 0.6 | round -%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--fd-fondo)' }};
  }
  #shopify-section-{{ section.id }} .fd-h2 { font-size: clamp({{ titulo_min }}px, 5vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .fd-montaje__cabecera { text-align: {{ section.settings.alineacion }}; }
  {%- if section.settings.alineacion == 'center' -%}
    #shopify-section-{{ section.id }} .fd-montaje__cabecera { margin-left: auto; margin-right: auto; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .fd-paso-m p { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<section class="fd-section fd-montaje" aria-label="{{ section.settings.titulo | strip_html | escape }}">
  <div class="fd-container">
    <div class="fd-montaje__cabecera">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fd-eyebrow fd-reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="fd-h2 fd-reveal" style="--fd-i: 1">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="fd-body fd-reveal" style="--fd-i: 2">{{ section.settings.texto | newline_to_br }}</p>
      {%- endif -%}
    </div>
    <ol class="fd-montaje__pasos">
      {%- for block in section.blocks -%}
        <li class="fd-paso-m fd-reveal" style="--fd-i: {{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="fd-paso-m__num">{{ forloop.index }}</span>
          <span class="fd-paso-m__icono">{% render 'fd-icono', nombre: block.settings.icono %}</span>
          <h3>{{ block.settings.titulo | escape }}</h3>
          <p>{{ block.settings.texto | escape }}</p>
        </li>
      {%- endfor -%}
    </ol>
  </div>
</section>

{% schema %}
{
  "name": "FlexiDesk – Montaje",
  "tag": "div",
  "class": "fd-wrap",
  "max_blocks": 5,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Montaje" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Lista en <em>unos minutos.</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto", "default": "Incluye la tornillería necesaria. El montaje es sencillo y no lleva más de unos minutos." },
    { "type": "header", "content": "Tipografía y color" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 52 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño del texto de los pasos (px)", "min": 13, "max": 20, "step": 1, "unit": "px", "default": 16 },
    { "type": "select", "id": "alineacion", "label": "Alineación de la cabecera", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "center" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo principal de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [ { "value": "caja", "label": "Caja" }, { "value": "llave", "label": "Herramienta" }, { "value": "altura", "label": "Altura" }, { "value": "ruedas", "label": "Ruedas" }, { "value": "portatil", "label": "Portátil" }, { "value": "check", "label": "Visto bueno" } ], "default": "caja" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Abre la caja" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Las piezas y la tornillería necesaria vienen incluidas." }
      ]
    }
  ],
  "presets": [
    {
      "name": "FlexiDesk – Montaje",
      "blocks": [
        { "type": "paso", "settings": { "icono": "caja", "titulo": "Abre la caja", "texto": "Las piezas y la tornillería necesaria vienen incluidas." } },
        { "type": "paso", "settings": { "icono": "llave", "titulo": "Atornilla", "texto": "Une la base con ruedas, la columna y el tablero." } },
        { "type": "paso", "settings": { "icono": "altura", "titulo": "Ajusta y listo", "texto": "Elige tu altura entre 60 y 90 cm y acércala donde la necesites." } }
      ]
    }
  ]
}
{% endschema %}
