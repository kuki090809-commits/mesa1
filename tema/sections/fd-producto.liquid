{%- liquid
  assign variante = product.selected_or_first_available_variant
  assign titulo_min = section.settings.titulo_tam | times: 0.65 | round
  assign media_activa = variante.featured_media | default: product.featured_media
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--fd-fondo)' }};
  }
  #shopify-section-{{ section.id }} .fd-producto { background: transparent; }
  #shopify-section-{{ section.id }} .fd-compra__titulo { font-size: clamp({{ titulo_min }}px, 4.6vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .fd-compra__intro { font-size: {{ section.settings.texto_tam }}px; }
  #shopify-section-{{ section.id }} .fd-caracteristicas { --fd-car-cols: {{ section.settings.car_columnas }}; }
  #shopify-section-{{ section.id }} .fd-compra { text-align: {{ section.settings.alineacion }}; }
{% endstyle %}

<section class="fd-section fd-producto" aria-label="{{ product.title | escape }}">
  <div class="fd-container">
    <div class="fd-producto__grid">

      {%- comment -%} ===== Galería (sigue a las fotos del producto en el catálogo) ===== {%- endcomment -%}
      <div class="fd-galeria" data-fd-galeria>
        <div class="fd-galeria__principal">
          {%- if product.media.size > 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign activa = false
                if media_activa
                  if media.id == media_activa.id
                    assign activa = true
                  endif
                elsif forloop.first
                  assign activa = true
                endif
              -%}
              {%- if activa -%}{%- assign carga = 'eager' -%}{%- else -%}{%- assign carga = 'lazy' -%}{%- endif -%}
              <div class="fd-galeria__slide{% if activa %} is-activa{% endif %}" data-media-id="{{ media.id }}">
                <div class="fd-media" style="--fd-ratio: 1 / 1;">
                  {%- case media.media_type -%}
                    {%- when 'image' -%}
                      {{ media | image_url: width: 1800 | image_tag:
                          class: 'fd-media__img',
                          loading: carga,
                          widths: '480, 720, 960, 1200, 1500, 1800',
                          sizes: '(min-width: 990px) 55vw, 100vw',
                          alt: media.alt | default: product.title
                      }}
                    {%- when 'video' -%}
                      {{ media | video_tag: class: 'fd-media__img', controls: true, muted: true, playsinline: true }}
                    {%- when 'external_video' -%}
                      {{ media | external_video_tag: class: 'fd-media__img' }}
                    {%- else -%}
                      {{ media.preview_image | image_url: width: 1800 | image_tag: class: 'fd-media__img', loading: 'lazy', alt: product.title }}
                  {%- endcase -%}
                </div>
              </div>
            {%- endfor -%}
          {%- else -%}
            <div class="fd-galeria__slide is-activa">
              {%- render 'fd-imagen', imagen: blank, tipo: 'frontal', alt: product.title -%}
            </div>
          {%- endif -%}
        </div>
        {%- if product.media.size > 1 -%}
          <ul class="fd-galeria__miniaturas" aria-label="Fotos del producto">
            {%- for media in product.media -%}
              {%- liquid
                assign activa = false
                if media_activa
                  if media.id == media_activa.id
                    assign activa = true
                  endif
                elsif forloop.first
                  assign activa = true
                endif
              -%}
              <li>
                <button type="button" class="fd-galeria__mini{% if activa %} is-activa{% endif %}" data-media-id="{{ media.id }}" aria-label="Ver foto {{ forloop.index }}" aria-current="{{ activa }}">
                  {{ media.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
                </button>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>

      {%- comment -%} ===== Columna de compra ===== {%- endcomment -%}
      <div
        class="fd-compra"
        data-fd-producto
        data-fd-ancla-barra
        data-fd-comprar="{{ section.settings.boton_texto | escape }}"
        data-fd-agotado="{{ section.settings.agotado_texto | escape }}"
      >
        {%- assign eyebrow = section.settings.eyebrow | default: product.vendor -%}
        {%- if eyebrow != blank -%}
          <p class="fd-eyebrow">{{ eyebrow | escape }}</p>
        {%- endif -%}
        <h1 class="fd-compra__titulo">{{ product.title | escape }}</h1>

        <div class="fd-compra__precio">
          <span class="fd-precio-actual" data-fd-precio>{{ variante.price | money }}</span>
          <s data-fd-tachado{% unless variante.compare_at_price > variante.price %} hidden{% endunless %}>
            {%- if variante.compare_at_price > variante.price -%}{{ variante.compare_at_price | money }}{%- endif -%}
          </s>
          {%- if variante.compare_at_price > variante.price -%}
            {%- assign ahorro = variante.compare_at_price | minus: variante.price | times: 100 | divided_by: variante.compare_at_price -%}
            <span class="fd-ahorro" data-fd-ahorro>-{{ ahorro }}%</span>
          {%- else -%}
            <span class="fd-ahorro" data-fd-ahorro hidden></span>
          {%- endif -%}
        </div>
        {%- capture nota -%}
          {%- if cart.taxes_included and section.settings.iva_texto != blank -%}{{ section.settings.iva_texto | escape }}{%- endif -%}
          {%- if cart.taxes_included and section.settings.iva_texto != blank and section.settings.impuestos_texto != blank %} · {% endif -%}
          {{- section.settings.impuestos_texto | escape -}}
        {%- endcapture -%}
        {%- if nota != blank -%}
          <p class="fd-compra__impuestos">{{ nota }}</p>
        {%- endif -%}

        <div class="fd-compra__intro fd-body">
          {%- if section.settings.intro != blank -%}
            {{ section.settings.intro }}
          {%- else -%}
            {{ product.description | strip_html | truncatewords: 40 }}
          {%- endif -%}
        </div>

        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <fieldset class="fd-opcion">
              <legend>{{ option.name | escape }}: <span>{{ option.selected_value | escape }}</span></legend>
              <div class="fd-opcion__valores">
                {%- for value in option.values -%}
                  {%- assign oid = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                  <input type="radio" id="fd-op-{{ oid }}" name="fd-op-{{ section.id }}-{{ option.position }}" value="{{ value | escape }}"{% if option.selected_value == value %} checked{% endif %}>
                  <label for="fd-op-{{ oid }}">{{ value | escape }}</label>
                {%- endfor -%}
              </div>
            </fieldset>
          {%- endfor -%}
          <script type="application/json" data-fd-variantes>
            [
              {%- for v in product.variants -%}
                {
                  "id": {{ v.id }},
                  "options": {{ v.options | json }},
                  "available": {{ v.available | json }},
                  "price": {{ v.price | money | json }},
                  "compare": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | money | json }}{% else %}null{% endif %},
                  "saving": {% if v.compare_at_price > v.price %}{{ v.compare_at_price | minus: v.price | times: 100 | divided_by: v.compare_at_price | prepend: '-' | append: '%' | json }}{% else %}null{% endif %},
                  "media": {% if v.featured_media %}"{{ v.featured_media.id }}"{% else %}null{% endif %}
                }{% unless forloop.last %},{% endunless %}
              {%- endfor -%}
            ]
          </script>
        {%- endunless -%}

        {%- render 'fd-form-compra',
          producto: product,
          seccion: section.id,
          texto_boton: section.settings.boton_texto,
          texto_agotado: section.settings.agotado_texto,
          cantidad: section.settings.mostrar_cantidad,
          pago_rapido: section.settings.pago_rapido,
          ancho: true
        -%}

        {%- assign garantias = section.blocks | where: 'type', 'garantia' -%}
        {%- if garantias.size > 0 -%}
          <ul class="fd-garantias">
            {%- for block in garantias -%}
              <li class="fd-garantia" {{ block.shopify_attributes }}>
                {%- render 'fd-icono', nombre: block.settings.icono -%}
                <span><b>{{ block.settings.titulo | escape }}</b>{{ block.settings.texto | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        <div class="fd-acordeon">
          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when 'acordeon' -%}
                <details {{ block.shopify_attributes }}{% if block.settings.abierto %} open{% endif %}>
                  <summary>{{ block.settings.titulo | escape }}</summary>
                  <div class="fd-acordeon__contenido">
                    {%- if block.settings.usar_descripcion -%}
                      {{ product.description }}
                    {%- else -%}
                      {{ block.settings.contenido }}
                    {%- endif -%}
                  </div>
                </details>
              {%- when 'incluye' -%}
                <details {{ block.shopify_attributes }}{% if block.settings.abierto %} open{% endif %}>
                  <summary>{{ block.settings.titulo | escape }}</summary>
                  <div class="fd-acordeon__contenido">
                    {%- assign items = block.settings.lista | newline_to_br | split: '<br />' -%}
                    <ul>
                      {%- for item in items -%}
                        {%- assign t = item | strip -%}
                        {%- if t != blank -%}<li>{{ t }}</li>{%- endif -%}
                      {%- endfor -%}
                    </ul>
                  </div>
                </details>
            {%- endcase -%}
          {%- endfor -%}
        </div>
      </div>
    </div>

    {%- comment -%} ===== Cuadrícula de características ===== {%- endcomment -%}
    {%- assign caracteristicas = section.blocks | where: 'type', 'caracteristica' -%}
    {%- if caracteristicas.size > 0 -%}
      <div class="fd-caracteristicas">
        {%- for block in caracteristicas -%}
          <div class="fd-caracteristica fd-reveal" style="--fd-i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
            <span class="fd-caracteristica__icono">{% render 'fd-icono', nombre: block.settings.icono %}</span>
            <h3>{{ block.settings.titulo | escape }}</h3>
            <p>{{ block.settings.texto | escape }}</p>
          </div>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>
</section>

<script type="application/ld+json">
  {{ product | structured_data }}
</script>

{% schema %}
{
  "name": "FlexiDesk – Ficha",
  "tag": "div",
  "class": "fd-wrap",
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño sobre el título", "info": "Vacío = nombre de la marca del producto." },
    { "type": "richtext", "id": "intro", "label": "Introducción bajo el precio", "info": "Vacío = el comienzo de la descripción del producto." },
    { "type": "text", "id": "iva_texto", "label": "Aviso de impuestos incluidos", "info": "Solo se muestra si tus precios incluyen impuestos (Configuración → Impuestos).", "default": "IVA incluido" },
    { "type": "text", "id": "impuestos_texto", "label": "Nota bajo el precio", "default": "Envío gratis en 5-7 días laborables" },
    { "type": "text", "id": "boton_texto", "label": "Botón de compra", "default": "Añadir al carrito" },
    { "type": "text", "id": "agotado_texto", "label": "Botón cuando está agotado", "default": "Agotado" },
    { "type": "checkbox", "id": "mostrar_cantidad", "label": "Mostrar selector de cantidad", "default": true },
    { "type": "checkbox", "id": "pago_rapido", "label": "Mostrar botón de pago rápido", "default": true },
    { "type": "header", "content": "Tipografía y color" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 48 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño de la introducción (px)", "min": 14, "max": 22, "step": 1, "unit": "px", "default": 17 },
    { "type": "select", "id": "alineacion", "label": "Alineación del texto", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "range", "id": "car_columnas", "label": "Columnas de características (ordenador)", "min": 2, "max": 4, "step": 1, "default": 3 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo principal de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "garantia",
      "name": "Garantía",
      "limit": 3,
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [ { "value": "envio", "label": "Envío" }, { "value": "devolucion", "label": "Devolución" }, { "value": "pago", "label": "Pago seguro" }, { "value": "caja", "label": "Caja" }, { "value": "check", "label": "Visto bueno" } ], "default": "envio" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Envío gratis" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "5-7 días laborables" }
      ]
    },
    {
      "type": "acordeon",
      "name": "Desplegable",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Descripción" },
        { "type": "checkbox", "id": "usar_descripcion", "label": "Mostrar la descripción del producto", "default": false },
        { "type": "richtext", "id": "contenido", "label": "Contenido (si no usas la descripción)" },
        { "type": "checkbox", "id": "abierto", "label": "Abierto al cargar", "default": false }
      ]
    },
    {
      "type": "incluye",
      "name": "Lista (qué incluye…)",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Qué incluye" },
        { "type": "textarea", "id": "lista", "label": "Elementos (uno por línea)", "default": "1 mesa auxiliar FlexiDesk\nTornillería para el montaje" },
        { "type": "checkbox", "id": "abierto", "label": "Abierto al cargar", "default": false }
      ]
    },
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "options": [ { "value": "altura", "label": "Altura" }, { "value": "ruedas", "label": "Ruedas" }, { "value": "superficie", "label": "Superficie" }, { "value": "llave", "label": "Montaje" }, { "value": "portatil", "label": "Portátil" }, { "value": "espacio", "label": "Espacio" }, { "value": "mano", "label": "Al alcance" }, { "value": "caja", "label": "Caja" }, { "value": "check", "label": "Visto bueno" }, { "value": "estrella", "label": "Estrella" } ], "default": "altura" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Altura de 60 a 90 cm" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Ajústala a tu posición: sofá, sillón o cama." }
      ]
    }
  ]
}
{% endschema %}
