{%- comment -%}
  Ordena: pie de página propio (sustituye al de Dawn en este tema).
  Todo se edita desde Personalizar → Pie de página.
{%- endcomment -%}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--or-oscuro)' }};
  }
  #shopify-section-{{ section.id }} .or-footer {
    --or-ft-fondo: {{ section.settings.fondo | default: 'var(--or-oscuro)' }};
    --or-ft-texto: {{ section.settings.texto | default: 'var(--or-claro)' }};
    background: transparent;
  }
  #shopify-section-{{ section.id }} .or-footer__links,
  #shopify-section-{{ section.id }} .or-footer__texto { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<footer class="or-section or-footer">
  <div class="or-container">
    <div class="or-footer__grid">
      <div class="or-footer__marca">
        <a href="{{ routes.root_url }}" aria-label="{{ section.settings.logo_texto | default: shop.name | escape }}">
          {%- if section.settings.logo != blank -%}
            {{ section.settings.logo | image_url: width: 600 | image_tag: width: section.settings.logo_ancho, loading: 'lazy', alt: section.settings.logo_texto, style: 'height:auto; margin-bottom:18px;' }}
          {%- else -%}
            {%- render 'or-logo', texto: section.settings.logo_texto, icono: section.settings.logo_icono, alto: 32 -%}
          {%- endif -%}
        </a>
        {%- if section.settings.lema != blank -%}
          <p class="or-footer__lema">{{ section.settings.lema | newline_to_br }}</p>
        {%- endif -%}
        {%- if section.settings.mostrar_redes -%}
          {%- render 'social-icons', class: 'or-footer__redes' -%}
        {%- endif -%}
      </div>

      {%- for c in (1..2) -%}
        {%- liquid
          assign k_titulo = 'col' | append: c | append: '_titulo'
          assign titulo_col = section.settings[k_titulo]
        -%}
        {%- if titulo_col != blank -%}
          <nav aria-label="{{ titulo_col | escape }}">
            <h2>{{ titulo_col | escape }}</h2>
            <ul class="or-footer__links">
              {%- for n in (1..5) -%}
                {%- liquid
                  assign k_l = 'col' | append: c | append: '_enlace' | append: n | append: '_texto'
                  assign k_u = 'col' | append: c | append: '_enlace' | append: n | append: '_url'
                  assign etiqueta = section.settings[k_l]
                  assign destino = section.settings[k_u]
                -%}
                {%- if etiqueta != blank -%}
                  <li><a href="{{ destino | default: '#' }}">{{ etiqueta | escape }}</a></li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </nav>
        {%- endif -%}
      {%- endfor -%}

      {%- if section.settings.contacto_titulo != blank -%}
        <div>
          <h2>{{ section.settings.contacto_titulo | escape }}</h2>
          {%- if section.settings.contacto_texto != blank -%}
            <p class="or-footer__texto">{{ section.settings.contacto_texto | newline_to_br }}</p>
          {%- endif -%}
          {%- if section.settings.contacto_email != blank -%}
            <p class="or-footer__texto" style="margin-top: 12px;"><a href="mailto:{{ section.settings.contacto_email | escape }}">{{ section.settings.contacto_email | escape }}</a></p>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    <div class="or-footer__barra">
      <span class="or-footer__copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | default: shop.name | escape }}</span>

      {%- if section.settings.mostrar_legales -%}
        <ul class="or-footer__legales">
          {%- for policy in shop.policies -%}
            {%- if policy.type != 'contact_information' -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
          {%- if section.settings.legal_extra_texto != blank -%}
            <li><a href="{{ section.settings.legal_extra_url | default: '#' }}">{{ section.settings.legal_extra_texto | escape }}</a></li>
          {%- endif -%}
          {%- if section.settings.legal_extra2_texto != blank -%}
            <li><a href="{{ section.settings.legal_extra2_url | default: '#' }}">{{ section.settings.legal_extra2_texto | escape }}</a></li>
          {%- endif -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.mostrar_idiomas and localization.available_languages.size > 1 -%}
        <ul class="or-footer__legales" aria-label="Idioma">
          {%- for language in localization.available_languages -%}
            <li><a href="{{ language.root_url }}" lang="{{ language.iso_code }}"{% if language.iso_code == request.locale.iso_code %} aria-current="true" style="text-decoration: underline;"{% endif %}>{{ language.endonym_name | capitalize }}</a></li>
          {%- endfor -%}
        </ul>
      {%- endif -%}

      {%- if section.settings.mostrar_pagos and shop.enabled_payment_types.size > 0 -%}
        <ul class="or-footer__pagos" aria-label="Formas de pago">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Ordena – Pie de página",
  "tag": "div",
  "class": "or-wrap",
  "settings": [
    { "type": "header", "content": "Marca" },
    { "type": "image_picker", "id": "logo", "label": "Imagen del logo (opcional)", "info": "Vacío = logo de texto." },
    { "type": "range", "id": "logo_ancho", "label": "Ancho de la imagen del logo (px)", "min": 60, "max": 300, "step": 10, "unit": "px", "default": 140 },
    { "type": "text", "id": "logo_texto", "label": "Logo de texto", "default": "Ordena" },
    { "type": "checkbox", "id": "logo_icono", "label": "Mostrar icono junto al texto", "default": true },
    { "type": "textarea", "id": "lema", "label": "Frase de la marca", "default": "Organización de cocina para casas reales: menos rebuscar, más cocinar." },
    { "type": "checkbox", "id": "mostrar_redes", "label": "Mostrar redes sociales", "info": "Los enlaces se ponen en Configuración del tema → Redes sociales.", "default": true },
    { "type": "header", "content": "Columna 1" },
    { "type": "text", "id": "col1_titulo", "label": "Título", "default": "Tienda" },
    { "type": "text", "id": "col1_enlace1_texto", "label": "Enlace 1: texto", "default": "Especiero Giratorio 360°" },
    { "type": "url", "id": "col1_enlace1_url", "label": "Enlace 1: destino" },
    { "type": "text", "id": "col1_enlace2_texto", "label": "Enlace 2: texto", "default": "Todos los productos" },
    { "type": "url", "id": "col1_enlace2_url", "label": "Enlace 2: destino" },
    { "type": "text", "id": "col1_enlace3_texto", "label": "Enlace 3: texto" },
    { "type": "url", "id": "col1_enlace3_url", "label": "Enlace 3: destino" },
    { "type": "text", "id": "col1_enlace4_texto", "label": "Enlace 4: texto" },
    { "type": "url", "id": "col1_enlace4_url", "label": "Enlace 4: destino" },
    { "type": "text", "id": "col1_enlace5_texto", "label": "Enlace 5: texto" },
    { "type": "url", "id": "col1_enlace5_url", "label": "Enlace 5: destino" },
    { "type": "header", "content": "Columna 2" },
    { "type": "text", "id": "col2_titulo", "label": "Título", "default": "Ayuda" },
    { "type": "text", "id": "col2_enlace1_texto", "label": "Enlace 1: texto", "default": "Preguntas frecuentes" },
    { "type": "url", "id": "col2_enlace1_url", "label": "Enlace 1: destino" },
    { "type": "text", "id": "col2_enlace2_texto", "label": "Enlace 2: texto", "default": "Envíos" },
    { "type": "url", "id": "col2_enlace2_url", "label": "Enlace 2: destino" },
    { "type": "text", "id": "col2_enlace3_texto", "label": "Enlace 3: texto", "default": "Devoluciones" },
    { "type": "url", "id": "col2_enlace3_url", "label": "Enlace 3: destino" },
    { "type": "text", "id": "col2_enlace4_texto", "label": "Enlace 4: texto", "default": "Contacto" },
    { "type": "url", "id": "col2_enlace4_url", "label": "Enlace 4: destino" },
    { "type": "text", "id": "col2_enlace5_texto", "label": "Enlace 5: texto" },
    { "type": "url", "id": "col2_enlace5_url", "label": "Enlace 5: destino" },
    { "type": "header", "content": "Contacto" },
    { "type": "text", "id": "contacto_titulo", "label": "Título", "default": "Hablemos" },
    { "type": "textarea", "id": "contacto_texto", "label": "Texto", "default": "¿Dudas con tu pedido? Te respondemos lo antes posible." },
    { "type": "text", "id": "contacto_email", "label": "Correo de contacto (opcional)" },
    { "type": "header", "content": "Barra inferior" },
    { "type": "text", "id": "copyright", "label": "Nombre junto al ©", "default": "Ordena" },
    { "type": "checkbox", "id": "mostrar_legales", "label": "Mostrar enlaces legales", "info": "Las políticas se editan en Configuración → Políticas.", "default": true },
    { "type": "text", "id": "legal_extra_texto", "label": "Enlace legal extra 1: texto", "default": "Política de cookies" },
    { "type": "url", "id": "legal_extra_url", "label": "Enlace legal extra 1: destino" },
    { "type": "text", "id": "legal_extra2_texto", "label": "Enlace legal extra 2: texto" },
    { "type": "url", "id": "legal_extra2_url", "label": "Enlace legal extra 2: destino" },
    { "type": "checkbox", "id": "mostrar_idiomas", "label": "Mostrar selector de idioma", "default": false },
    { "type": "checkbox", "id": "mostrar_pagos", "label": "Mostrar formas de pago", "default": true },
    { "type": "header", "content": "Estilo" },
    { "type": "range", "id": "texto_tam", "label": "Tamaño del texto (px)", "min": 12, "max": 20, "step": 1, "unit": "px", "default": 15 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo oscuro de la marca." },
    { "type": "color", "id": "texto", "label": "Color del texto", "info": "Vacío = texto sobre fondo oscuro." },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 40 }
  ]
}
{% endschema %}
