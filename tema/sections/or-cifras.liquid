{%- assign titulo_min = section.settings.titulo_tam | times: 0.6 | round -%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--or-oscuro)' }};
  }
  #shopify-section-{{ section.id }} .or-cifras {
    --or-cf-fondo: {{ section.settings.fondo | default: 'var(--or-oscuro)' }};
    --or-cf-texto: {{ section.settings.texto | default: 'var(--or-claro)' }};
    --or-cf-tam: {{ section.settings.numero_tam }}px;
  }
  #shopify-section-{{ section.id }} .or-h2 { font-size: clamp({{ titulo_min }}px, 4.4vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .or-cifra__texto { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<section class="or-section or-cifras" aria-label="{{ section.settings.titulo | strip_html | default: 'Cifras' | escape }}">
  <div class="or-container">
    {%- if section.settings.titulo != blank -%}
      <h2 class="or-h2 or-reveal">{{ section.settings.titulo }}</h2>
    {%- endif -%}
    <div class="or-cifras__grid">
      {%- for block in section.blocks -%}
        {%- liquid
          assign num_txt = block.settings.numero | strip
          assign num_val = num_txt | remove: '.' | remove: ',' | plus: 0
          assign es_num = false
          if num_val > 0 or num_txt == '0'
            assign comprobacion = num_val | append: ''
            assign limpio = num_txt | remove: '.' | remove: ','
            if comprobacion == limpio
              assign es_num = true
            endif
          endif
        -%}
        <div class="or-cifra or-reveal" style="--or-i: {{ forloop.index }}" {{ block.shopify_attributes }}>
          <span class="or-cifra__num"{% if es_num and section.settings.animar %} data-or-contar="{{ num_val }}"{% endif %}>
            <span class="or-cifra__valor">{{ num_txt | escape }}</span>
            {%- if block.settings.sufijo != blank -%}<small>{{ block.settings.sufijo | escape }}</small>{%- endif -%}
          </span>
          {%- if block.settings.texto != blank -%}
            <span class="or-cifra__texto">{{ block.settings.texto | escape }}</span>
          {%- endif -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ordena – Cifras",
  "tag": "div",
  "class": "or-wrap",
  "max_blocks": 4,
  "settings": [
    { "type": "inline_richtext", "id": "titulo", "label": "Título (opcional)", "default": "Menos botes que mover, <em>más cocina.</em>" },
    { "type": "checkbox", "id": "animar", "label": "Animar los números al aparecer", "default": true },
    { "type": "header", "content": "Tipografía" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 72, "step": 2, "unit": "px", "default": 44 },
    { "type": "range", "id": "numero_tam", "label": "Tamaño de los números (px)", "min": 40, "max": 160, "step": 4, "unit": "px", "default": 112 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 },
    { "type": "header", "content": "Colores" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo oscuro de la marca." },
    { "type": "color", "id": "texto", "label": "Color del texto", "info": "Vacío = texto sobre fondo oscuro de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "cifra",
      "name": "Cifra",
      "settings": [
        { "type": "text", "id": "numero", "label": "Número", "info": "Solo cifras para que se anime (por ejemplo 360).", "default": "360" },
        { "type": "text", "id": "sufijo", "label": "Detrás del número", "default": "°" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "de giro para llegar a cualquier bote" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ordena – Cifras",
      "blocks": [
        { "type": "cifra", "settings": { "numero": "360", "sufijo": "°", "texto": "de giro para llegar a cualquier bote" } },
        { "type": "cifra", "settings": { "numero": "1", "sufijo": "", "texto": "solo hueco en la encimera o el armario" } },
        { "type": "cifra", "settings": { "numero": "0", "sufijo": "", "texto": "botes que mover para coger el de detrás" } }
      ]
    }
  ]
}
{% endschema %}
