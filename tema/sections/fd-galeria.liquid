{%- liquid
  assign producto = section.settings.producto
  assign titulo_min = section.settings.titulo_tam | times: 0.6 | round
  assign pies = section.settings.pies | newline_to_br | split: '<br />'
-%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--fd-fondo-alt)' }};
  }
  #shopify-section-{{ section.id }} .fd-h2 { font-size: clamp({{ titulo_min }}px, 5vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .fd-galeria-casa__fotos { --fd-polaroid: {{ section.settings.ancho }}px; }
{% endstyle %}

<section class="fd-section fd-galeria-casa" aria-label="{{ section.settings.titulo | strip_html | escape }}">
  <div class="fd-container">
    <div class="fd-galeria-casa__cabecera">
      {%- if section.settings.eyebrow != blank -%}
        <p class="fd-eyebrow fd-reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="fd-h2 fd-reveal" style="--fd-i: 1">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="fd-body fd-reveal" style="--fd-i: 2">{{ section.settings.texto | newline_to_br }}</p>
      {%- endif -%}
    </div>
    <ul class="fd-galeria-casa__fotos">
      {%- if section.blocks.size > 0 -%}
        {%- for block in section.blocks -%}
          <li class="fd-polaroid fd-reveal" style="--fd-i: {{ forloop.index }}" {{ block.shopify_attributes }}>
            {%- render 'fd-imagen', imagen: block.settings.imagen, tipo: 'frontal', clase: 'fd-polaroid__foto', sizes: '320px', alt: block.settings.pie -%}
            {%- if block.settings.pie != blank -%}<span class="fd-polaroid__pie">{{ block.settings.pie | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- elsif producto != blank and producto.images.size > 0 -%}
        {%- for img in producto.images limit: section.settings.maximo -%}
          {%- assign pie = pies[forloop.index0] | strip -%}
          <li class="fd-polaroid fd-reveal" style="--fd-i: {{ forloop.index }}">
            {%- render 'fd-imagen', imagen: img, clase: 'fd-polaroid__foto', sizes: '320px', alt: pie -%}
            {%- if pie != blank -%}<span class="fd-polaroid__pie">{{ pie | escape }}</span>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        <li class="fd-polaroid">
          {%- render 'fd-imagen', imagen: blank, tipo: 'frontal', clase: 'fd-polaroid__foto', alt: section.settings.titulo -%}
        </li>
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "FlexiDesk – En casa",
  "tag": "div",
  "class": "fd-wrap",
  "max_blocks": 6,
  "settings": [
    { "type": "paragraph", "content": "Muestra las fotos del producto elegido. Si añades bloques «Foto», se usan esos en su lugar." },
    { "type": "product", "id": "producto", "label": "Producto" },
    { "type": "range", "id": "maximo", "label": "Número máximo de fotos", "min": 1, "max": 6, "step": 1, "default": 4 },
    { "type": "textarea", "id": "pies", "label": "Pies de foto (uno por línea, en orden)", "default": "Junto al sofá\nSobre la cama\nEn el dormitorio" },
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Así queda en casa" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Se adapta a tu rincón <em>favorito.</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto" },
    { "type": "header", "content": "Estilo" },
    { "type": "range", "id": "ancho", "label": "Ancho de cada foto (px)", "min": 180, "max": 400, "step": 10, "unit": "px", "default": 240 },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 48 },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo secundario de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 104 }
  ],
  "blocks": [
    {
      "type": "foto",
      "name": "Foto",
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto" },
        { "type": "text", "id": "pie", "label": "Pie de foto" }
      ]
    }
  ],
  "presets": [ { "name": "FlexiDesk – En casa" } ]
}
{% endschema %}
