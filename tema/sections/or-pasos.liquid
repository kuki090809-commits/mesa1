{%- assign titulo_min = section.settings.titulo_tam | times: 0.6 | round -%}
{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.fondo | default: 'var(--or-fondo)' }};
  }
  #shopify-section-{{ section.id }} .or-pasos { background: transparent; }
  #shopify-section-{{ section.id }} .or-h2 { font-size: clamp({{ titulo_min }}px, 5vw, {{ section.settings.titulo_tam }}px); }
  #shopify-section-{{ section.id }} .or-pasos__cabecera { text-align: {{ section.settings.alineacion }}; }
  {%- if section.settings.alineacion == 'center' -%}
    #shopify-section-{{ section.id }} .or-pasos__cabecera { margin-left: auto; margin-right: auto; }
  {%- endif -%}
  #shopify-section-{{ section.id }} .or-paso { --or-paso-tam: {{ section.settings.paso_tam }}px; }
  #shopify-section-{{ section.id }} .or-paso .or-body { font-size: {{ section.settings.texto_tam }}px; }
{% endstyle %}

<section id="{{ section.settings.ancla | default: 'como-funciona' | handleize }}" class="or-section or-pasos" aria-label="{{ section.settings.titulo | strip_html | escape }}">
  <div class="or-container">
    <div class="or-pasos__cabecera">
      {%- if section.settings.eyebrow != blank -%}
        <p class="or-eyebrow or-reveal">{{ section.settings.eyebrow }}</p>
      {%- endif -%}
      <h2 class="or-h2 or-reveal" style="--or-i: 1">{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}
        <p class="or-body or-reveal" style="--or-i: 2; margin-top: 16px;">{{ section.settings.texto | newline_to_br }}</p>
      {%- endif -%}
    </div>

    <div class="or-pasos__grid" data-or-pasos data-or-grados="{{ section.settings.grados }}">
      <div class="or-pasos__visual or-reveal">
        {%- render 'or-imagen', imagen: section.settings.imagen, tipo: 'cenital', sizes: '(min-width: 990px) 45vw, 80vw', alt: section.settings.titulo -%}
      </div>
      <ol class="or-pasos__lista">
        {%- for block in section.blocks -%}
          <li class="or-paso{% if forloop.first %} is-activo{% endif %}" {{ block.shopify_attributes }}>
            <span class="or-paso__num" aria-hidden="true">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
            <h3 class="or-h3">{{ block.settings.titulo | escape }}</h3>
            {%- if block.settings.texto != blank -%}
              <p class="or-body">{{ block.settings.texto | newline_to_br }}</p>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Ordena – Cómo funciona",
  "tag": "div",
  "class": "or-wrap",
  "max_blocks": 6,
  "settings": [
    { "type": "header", "content": "Textos" },
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Cómo funciona" },
    { "type": "inline_richtext", "id": "titulo", "label": "Título", "default": "Tres pasos y <em>a cocinar.</em>" },
    { "type": "textarea", "id": "texto", "label": "Texto (opcional)" },
    { "type": "text", "id": "ancla", "label": "Nombre del ancla", "info": "Los botones que enlazan a «#como-funciona» bajan hasta aquí.", "default": "como-funciona" },
    { "type": "header", "content": "Imagen" },
    { "type": "image_picker", "id": "imagen", "label": "Foto (opcional)", "info": "Si no pones foto, se ve el especiero desde arriba girando con cada paso." },
    { "type": "range", "id": "grados", "label": "Giro del especiero por paso (grados)", "min": 30, "max": 180, "step": 10, "unit": "°", "default": 120 },
    { "type": "header", "content": "Tipografía y color" },
    { "type": "range", "id": "titulo_tam", "label": "Tamaño del título (px)", "min": 24, "max": 80, "step": 2, "unit": "px", "default": 54 },
    { "type": "range", "id": "paso_tam", "label": "Tamaño del título de cada paso (px)", "min": 20, "max": 56, "step": 2, "unit": "px", "default": 36 },
    { "type": "range", "id": "texto_tam", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "select", "id": "alineacion", "label": "Alineación de la cabecera", "options": [ { "value": "left", "label": "Izquierda" }, { "value": "center", "label": "Centro" } ], "default": "left" },
    { "type": "color", "id": "fondo", "label": "Color de fondo", "info": "Vacío = fondo principal de la marca." },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 72 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "titulo", "label": "Título", "default": "Colócalo" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "En la encimera o dentro del armario." }
      ]
    }
  ],
  "presets": [
    {
      "name": "Ordena – Cómo funciona",
      "blocks": [
        { "type": "paso", "settings": { "titulo": "Colócalo", "texto": "Busca su sitio en la encimera o dentro del armario. Ocupa un solo hueco en lugar de varios botes sueltos." } },
        { "type": "paso", "settings": { "titulo": "Llénalo", "texto": "Reúne tus especias en un único punto: pimentón, comino, orégano, canela… todas juntas y a la vista." } },
        { "type": "paso", "settings": { "titulo": "Gíralo", "texto": "Un giro y el bote que buscas viene a ti. Sin mover los demás, sin rebuscar al fondo." } }
      ]
    }
  ]
}
{% endschema %}
