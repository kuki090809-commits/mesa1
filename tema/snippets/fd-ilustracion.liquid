{%- comment -%}
  FlexiDesk: ilustraciones de respaldo (se ven mientras no subas fotos).
  Uso: {% render 'fd-ilustracion', tipo: 'sofa' %}
  tipos: sofa (panorámica) · frontal · antes · despues
{%- endcomment -%}
{%- liquid
  assign t = tipo | default: 'frontal'
  assign vb = '0 0 600 600'
  assign par = 'xMidYMid meet'
  if t == 'sofa'
    assign vb = '0 0 1000 500'
    assign par = 'xMidYMax slice'
  endif
-%}
<svg class="fd-ilu fd-ilu--{{ t }}" viewBox="{{ vb }}" preserveAspectRatio="{{ par }}" role="img" aria-label="{{ etiqueta | default: 'Ilustración de la mesa auxiliar FlexiDesk' | escape }}" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <symbol id="fd-mesa" viewBox="0 0 400 600">
      <ellipse cx="200" cy="576" rx="150" ry="9" style="fill:var(--fd-texto);opacity:.1"/>
      <rect x="191" y="186" width="18" height="170" style="fill:#5B616B"/>
      <rect x="70" y="544" width="260" height="14" rx="7" style="fill:#2A2D33"/>
      <rect x="176" y="532" width="48" height="16" rx="6" style="fill:#2A2D33"/>
      <circle cx="88" cy="566" r="12" style="fill:#17191D"/><circle cx="88" cy="566" r="4" style="fill:#8B95A5"/>
      <circle cx="312" cy="566" r="12" style="fill:#17191D"/><circle cx="312" cy="566" r="4" style="fill:#8B95A5"/>
      <rect x="186" y="330" width="28" height="210" rx="5" style="fill:#2A2D33"/>
      <rect x="190" y="336" width="4" height="196" rx="2" style="fill:#fff;opacity:.14"/>
      <rect x="212" y="352" width="14" height="9" rx="3" style="fill:#17191D"/>
      <circle cx="230" cy="356.5" r="8" style="fill:#17191D"/>
      <rect x="150" y="186" width="100" height="10" rx="4" style="fill:#2A2D33"/>
      <polygon points="64,146 336,146 360,176 40,176" style="fill:#50555E"/>
      <rect x="40" y="176" width="320" height="11" rx="3" style="fill:#2E3238"/>
      <rect x="136" y="70" width="128" height="86" rx="6" style="fill:#C9CDD3"/>
      <rect x="143" y="77" width="114" height="72" rx="3" style="fill:#1E2638"/>
      <rect x="151" y="87" width="56" height="8" rx="4" style="fill:var(--fd-acento)"/>
      <rect x="151" y="101" width="90" height="5" rx="2.5" style="fill:#fff;opacity:.28"/>
      <rect x="151" y="111" width="68" height="5" rx="2.5" style="fill:#fff;opacity:.28"/>
      <rect x="151" y="124" width="44" height="16" rx="4" style="fill:#fff;opacity:.14"/>
      <polygon points="132,156 268,156 284,172 116,172" style="fill:#B7BCC4"/>
      <rect x="116" y="170" width="168" height="4" rx="2" style="fill:#9CA2AB"/>
      <rect x="300" y="146" width="22" height="26" rx="4" style="fill:#fff"/>
      <rect x="300" y="155" width="22" height="5" style="fill:var(--fd-acento);opacity:.9"/>
      <path d="M322 152 h4 a6 6 0 0 1 0 12 h-4" style="fill:none;stroke:#fff;stroke-width:3"/>
    </symbol>
    <symbol id="fd-sofa" viewBox="0 0 800 600">
      <ellipse cx="400" cy="558" rx="360" ry="10" style="fill:var(--fd-texto);opacity:.08"/>
      <rect x="80" y="236" width="640" height="210" rx="44" style="fill:#CFCBC3"/>
      <rect x="116" y="258" width="276" height="160" rx="34" style="fill:#E0DCD5"/>
      <rect x="408" y="258" width="276" height="160" rx="34" style="fill:#E0DCD5"/>
      <rect x="150" y="304" width="118" height="94" rx="26" transform="rotate(8 209 351)" style="fill:var(--fd-acento);opacity:.88"/>
      <rect x="104" y="398" width="592" height="112" rx="26" style="fill:#D9D5CE"/>
      <rect x="104" y="398" width="592" height="30" rx="15" style="fill:#E4E0D9"/>
      <rect x="398.5" y="406" width="3" height="98" style="fill:#C6C1B9"/>
      <rect x="36" y="320" width="112" height="212" rx="40" style="fill:#C9C4BC"/>
      <rect x="652" y="320" width="112" height="212" rx="40" style="fill:#C9C4BC"/>
      <rect x="110" y="526" width="16" height="30" rx="4" style="fill:#8A6A4A"/>
      <rect x="674" y="526" width="16" height="30" rx="4" style="fill:#8A6A4A"/>
    </symbol>
  </defs>

  {%- case t -%}
    {%- when 'sofa' -%}
      <rect x="0" y="0" width="1000" height="500" style="fill:var(--fd-fondo-alt)"/>
      <rect x="0" y="440" width="1000" height="60" style="fill:#D7D8D1"/>
      <rect x="0" y="438" width="1000" height="4" style="fill:#C9CAC3"/>
      <rect x="318" y="62" width="126" height="92" rx="8" style="fill:#fff;opacity:.6"/>
      <rect x="330" y="74" width="102" height="68" rx="4" style="fill:var(--fd-acento);opacity:.22"/>
      <circle cx="362" cy="118" r="14" style="fill:var(--fd-acento);opacity:.5"/>
      <rect x="462" y="84" width="72" height="72" rx="8" style="fill:#fff;opacity:.6"/>
      <path d="M474 140 l16 -24 12 14 10 -10 10 20 z" style="fill:var(--fd-texto);opacity:.25"/>
      <rect x="76" y="380" width="54" height="60" rx="8" style="fill:#fff;stroke:#C9CAC3;stroke-width:2"/>
      <ellipse cx="88" cy="350" rx="14" ry="34" transform="rotate(-24 88 350)" style="fill:#7F9A7A"/>
      <ellipse cx="114" cy="344" rx="13" ry="38" transform="rotate(18 114 344)" style="fill:#6E8A69"/>
      <ellipse cx="102" cy="330" rx="11" ry="40" style="fill:#8BA685"/>
      <rect x="880" y="140" width="5" height="300" style="fill:#2A2D33"/>
      <ellipse cx="882" cy="438" rx="34" ry="6" style="fill:#2A2D33"/>
      <path d="M844 140 h78 l-14 -56 h-50 z" style="fill:#fff;opacity:.85"/>
      <ellipse cx="883" cy="150" rx="70" ry="16" style="fill:#fff;opacity:.25"/>
      <use href="#fd-sofa" x="140" y="40" width="576" height="432"/>
      <use href="#fd-mesa" x="520" y="164" width="192" height="288"/>

    {%- when 'antes' or 'despues' -%}
      <rect x="0" y="0" width="600" height="600" style="fill:var(--fd-fondo-alt)"/>
      <rect x="0" y="470" width="600" height="130" style="fill:#D7D8D1"/>
      <rect x="0" y="468" width="600" height="4" style="fill:#C9CAC3"/>
      <rect x="60" y="92" width="110" height="80" rx="8" style="fill:#fff;opacity:.6"/>
      <rect x="71" y="103" width="88" height="58" rx="4" style="fill:var(--fd-acento);opacity:.2"/>
      <use href="#fd-sofa" x="36" y="103" width="528" height="396"/>
      {%- if t == 'antes' -%}
        <rect x="318" y="338" width="122" height="40" rx="18" style="fill:#EDEAE4"/>
        <g transform="rotate(-10 380 336)">
          <polygon points="336,342 424,342 434,352 326,352" style="fill:#B7BCC4"/>
          <rect x="342" y="286" width="76" height="54" rx="4" style="fill:#C9CDD3"/>
          <rect x="346" y="290" width="68" height="46" rx="2" style="fill:#1E2638"/>
          <rect x="351" y="296" width="34" height="5" rx="2.5" style="fill:var(--fd-acento)"/>
          <rect x="351" y="305" width="50" height="3" rx="1.5" style="fill:#fff;opacity:.3"/>
        </g>
        <rect x="470" y="446" width="22" height="26" rx="4" style="fill:#fff"/>
        <rect x="470" y="455" width="22" height="5" style="fill:var(--fd-acento);opacity:.9"/>
        <path d="M492 452 h4 a6 6 0 0 1 0 12 h-4" style="fill:none;stroke:#fff;stroke-width:3"/>
      {%- else -%}
        <use href="#fd-mesa" x="330" y="212" width="180" height="270"/>
      {%- endif -%}

    {%- else -%}
      <rect x="40" y="572" width="520" height="3" rx="1.5" style="fill:var(--fd-texto);opacity:.12"/>
      <use href="#fd-mesa" x="100" y="0" width="400" height="600"/>
  {%- endcase -%}
</svg>
