{%- comment -%} FlexiDesk: logo de texto con icono (se usa cuando no hay imagen de logo). {%- endcomment -%}
{%- assign tam = alto | default: 26 -%}
<span class="fd-logo" style="--fd-logo-tam: {{ tam }}px;">
  {%- if icono != false -%}
    <svg class="fd-logo__icono" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <g class="fd-logo__sube">
        <rect x="13" y="5" width="22" height="9" rx="2" fill="var(--fd-acento)"/>
        <rect x="5" y="15" width="38" height="5" rx="2.5" fill="currentColor"/>
        <rect x="21.5" y="20" width="5" height="12" fill="currentColor" opacity=".55"/>
      </g>
      <rect x="20.5" y="27" width="7" height="12" rx="1.5" fill="currentColor"/>
      <rect x="9" y="38" width="30" height="4.5" rx="2.25" fill="currentColor"/>
      <circle cx="12" cy="44.5" r="2.6" fill="currentColor"/>
      <circle cx="36" cy="44.5" r="2.6" fill="currentColor"/>
    </svg>
  {%- endif -%}
  <span class="fd-logo__texto">{{ texto | default: shop.name | escape }}</span>
</span>
