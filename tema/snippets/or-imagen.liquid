{%- comment -%}
  Ordena: hueco de imagen editable.
  - Si eliges una foto en el editor, se muestra la foto.
  - Si no, se muestra la ilustración de respaldo (tipo) y, solo dentro del
    editor de Shopify, un aviso para recordarte que puedes poner tu foto.
  Parámetros: imagen, tipo, clase, eager (true/false), sizes, alt
{%- endcomment -%}
{%- liquid
  assign carga = 'lazy'
  assign prioridad = 'auto'
  if eager
    assign carga = 'eager'
    assign prioridad = 'high'
  endif
  assign tam = sizes | default: '(min-width: 990px) 50vw, 100vw'
-%}
<div class="or-media {{ clase }}{% if imagen == blank %} or-media--vacia{% endif %}">
  {%- if imagen != blank -%}
    {{ imagen | image_url: width: 2400 | image_tag:
        class: 'or-media__img',
        loading: carga,
        fetchpriority: prioridad,
        widths: '480, 720, 960, 1200, 1600, 2000, 2400',
        sizes: tam,
        alt: imagen.alt | default: alt
    }}
  {%- else -%}
    <div class="or-media__ilu">{% render 'or-ilustracion', tipo: tipo, etiqueta: alt %}</div>
    {%- if request.design_mode -%}
      <span class="or-media__aviso">
        <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true"><path d="M4 7h3l2-2h6l2 2h3v12H4z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/><circle cx="12" cy="13" r="3.5" fill="none" stroke="currentColor" stroke-width="2"/></svg>
        Pon tu foto aquí (panel de la izquierda)
      </span>
    {%- endif -%}
  {%- endif -%}
</div>
