{%- comment -%}
  Ordena: ilustraciones de respaldo (se ven mientras no subas fotos).
  Uso: {% render 'or-ilustracion', tipo: 'frontal' %}
  tipos: frontal · cenital · antes · despues · encimera
{%- endcomment -%}
{%- liquid
  assign t = tipo | default: 'frontal'
  assign c_pimenton = '#C4502A'
  assign c_curcuma = '#D9A23B'
  assign c_hierbas = '#6E7F55'
  assign c_pimienta = '#3B3A36'
  assign c_sal = '#E6DCC9'
  assign c_canela = '#9B5B34'
-%}
<svg class="or-ilu or-ilu--{{ t }}" viewBox="0 0 600 600"{% if t == 'encimera' %} preserveAspectRatio="xMidYMax slice"{% endif %} role="img" aria-label="{{ etiqueta | default: 'Ilustración del especiero giratorio' | escape }}" xmlns="http://www.w3.org/2000/svg">
  <defs>
    <symbol id="or-tarro" viewBox="0 0 60 100">
      <rect x="2" y="18" width="56" height="80" rx="11" style="fill:rgba(255,255,255,.6);stroke:var(--or-texto);stroke-width:2.5"/>
      <rect x="6.5" y="44" width="47" height="49.5" rx="7.5" style="fill:currentColor"/>
      <rect x="12" y="27" width="36" height="12" rx="3" style="fill:var(--or-fondo);stroke:var(--or-texto);stroke-width:1.5"/>
      <rect x="9" y="50" width="4.5" height="36" rx="2.25" style="fill:#fff;opacity:.45"/>
      <rect x="6" y="0" width="48" height="19" rx="5" style="fill:var(--or-texto)"/>
      <rect x="10" y="4" width="18" height="3" rx="1.5" style="fill:#fff;opacity:.25"/>
    </symbol>
    <symbol id="or-carrusel" viewBox="0 0 600 600">
      <ellipse cx="300" cy="548" rx="232" ry="24" style="fill:var(--or-texto);opacity:.1"/>
      <ellipse cx="300" cy="512" rx="222" ry="44" style="fill:#BFA987"/>
      <rect x="78" y="490" width="444" height="22" style="fill:#BFA987"/>
      <ellipse cx="300" cy="490" rx="222" ry="44" style="fill:#DCCBAE"/>
      <ellipse cx="300" cy="490" rx="200" ry="36" style="fill:none;stroke:#C9B593;stroke-width:2"/>
      <rect x="291" y="118" width="18" height="380" rx="9" style="fill:var(--or-texto)"/>
      <circle cx="300" cy="114" r="17" style="fill:var(--or-texto)"/>
      <circle cx="295" cy="109" r="5" style="fill:#fff;opacity:.3"/>
      {%- comment -%} piso inferior, fila trasera {%- endcomment -%}
      <use href="#or-tarro" x="168" y="378" width="54" height="90" style="color:{{ c_hierbas }}"/>
      <use href="#or-tarro" x="378" y="378" width="54" height="90" style="color:{{ c_curcuma }}"/>
      {%- comment -%} piso inferior, fila delantera {%- endcomment -%}
      <use href="#or-tarro" x="98" y="414" width="60" height="100" style="color:{{ c_canela }}"/>
      <use href="#or-tarro" x="182" y="420" width="64" height="106" style="color:{{ c_pimenton }}"/>
      <use href="#or-tarro" x="266" y="424" width="68" height="112" style="color:{{ c_sal }}"/>
      <use href="#or-tarro" x="354" y="420" width="64" height="106" style="color:{{ c_pimienta }}"/>
      <use href="#or-tarro" x="442" y="414" width="60" height="100" style="color:{{ c_hierbas }}"/>
      {%- comment -%} piso superior {%- endcomment -%}
      <ellipse cx="300" cy="304" rx="178" ry="33" style="fill:#BFA987"/>
      <rect x="122" y="290" width="356" height="14" style="fill:#BFA987"/>
      <ellipse cx="300" cy="290" rx="178" ry="33" style="fill:#DCCBAE"/>
      <rect x="291" y="230" width="18" height="70" rx="9" style="fill:var(--or-texto)"/>
      <use href="#or-tarro" x="200" y="200" width="46" height="77" style="color:{{ c_pimenton }}"/>
      <use href="#or-tarro" x="354" y="200" width="46" height="77" style="color:{{ c_hierbas }}"/>
      <use href="#or-tarro" x="138" y="226" width="52" height="86" style="color:{{ c_curcuma }}"/>
      <use href="#or-tarro" x="204" y="232" width="56" height="92" style="color:{{ c_pimienta }}"/>
      <use href="#or-tarro" x="270" y="234" width="60" height="96" style="color:{{ c_canela }}"/>
      <use href="#or-tarro" x="340" y="232" width="56" height="92" style="color:{{ c_sal }}"/>
      <use href="#or-tarro" x="410" y="226" width="52" height="86" style="color:{{ c_pimenton }}"/>
    </symbol>
  </defs>

  {%- case t -%}
    {%- when 'cenital' -%}
      <circle cx="300" cy="300" r="250" style="fill:var(--or-texto);opacity:.06"/>
      <g class="or-ilu__giro">
        <circle cx="300" cy="300" r="232" style="fill:#DCCBAE;stroke:#BFA987;stroke-width:12"/>
        <circle cx="300" cy="300" r="128" style="fill:none;stroke:#C9B593;stroke-width:3;stroke-dasharray:6 10"/>
        {%- assign colores = c_pimenton | append: ',' | append: c_curcuma | append: ',' | append: c_hierbas | append: ',' | append: c_pimienta | append: ',' | append: c_canela | append: ',' | append: c_sal | split: ',' -%}
        {%- for i in (0..9) -%}
          {%- assign ang = i | times: 36 -%}
          {%- assign ci = i | modulo: 6 -%}
          <g transform="rotate({{ ang }} 300 300)">
            <circle cx="300" cy="122" r="38" style="fill:var(--or-texto)"/>
            <circle cx="300" cy="122" r="29" style="fill:{{ colores[ci] }}"/>
            <circle cx="292" cy="113" r="7" style="fill:#fff;opacity:.3"/>
            {%- if i == 0 -%}<circle class="or-ilu__objetivo" cx="300" cy="122" r="47" style="fill:none;stroke:var(--or-acento);stroke-width:6"/>{%- endif -%}
          </g>
        {%- endfor -%}
        {%- for i in (0..5) -%}
          {%- assign ang = i | times: 60 | plus: 30 -%}
          {%- assign ci = i | plus: 2 | modulo: 6 -%}
          <g transform="rotate({{ ang }} 300 300)">
            <circle cx="300" cy="212" r="28" style="fill:var(--or-texto)"/>
            <circle cx="300" cy="212" r="21" style="fill:{{ colores[ci] }}"/>
          </g>
        {%- endfor -%}
        <circle cx="300" cy="300" r="30" style="fill:var(--or-texto)"/>
        <circle cx="292" cy="292" r="8" style="fill:#fff;opacity:.3"/>
      </g>
      <path d="M300 570 l-22 -34 h44 z" style="fill:var(--or-acento)"/>
      <path d="M74 214 A 244 244 0 0 1 214 74" style="fill:none;stroke:var(--or-acento);stroke-width:6;stroke-linecap:round"/>
      <path d="M200 60 l26 8 -16 22" style="fill:none;stroke:var(--or-acento);stroke-width:6;stroke-linecap:round;stroke-linejoin:round"/>

    {%- when 'antes' or 'despues' -%}
      <rect x="40" y="40" width="520" height="520" rx="22" style="fill:#E7DAC3;stroke:var(--or-texto);stroke-width:5"/>
      <rect x="58" y="58" width="484" height="484" rx="12" style="fill:#EFE5D3"/>
      <rect x="40" y="314" width="520" height="18" style="fill:#C9B593;stroke:var(--or-texto);stroke-width:4"/>
      {%- if t == 'antes' -%}
        {%- comment -%} balda de arriba: botes amontonados {%- endcomment -%}
        <use href="#or-tarro" x="96" y="168" width="54" height="90" style="color:{{ c_hierbas }}"/>
        <use href="#or-tarro" x="182" y="150" width="54" height="90" style="color:{{ c_canela }}"/>
        <use href="#or-tarro" x="300" y="160" width="54" height="90" style="color:{{ c_sal }}"/>
        <use href="#or-tarro" x="410" y="152" width="54" height="90" style="color:{{ c_curcuma }}"/>
        <use href="#or-tarro" x="128" y="206" width="64" height="106" style="color:{{ c_pimenton }}"/>
        <use href="#or-tarro" x="236" y="196" width="66" height="112" transform="rotate(-9 269 308)" style="color:{{ c_pimienta }}"/>
        <use href="#or-tarro" x="352" y="208" width="62" height="104" style="color:{{ c_hierbas }}"/>
        <use href="#or-tarro" x="446" y="210" width="62" height="102" transform="rotate(7 477 312)" style="color:{{ c_canela }}"/>
        {%- comment -%} balda de abajo: más botes y uno caído {%- endcomment -%}
        <use href="#or-tarro" x="90" y="402" width="56" height="94" style="color:{{ c_curcuma }}"/>
        <use href="#or-tarro" x="226" y="396" width="56" height="94" style="color:{{ c_pimenton }}"/>
        <use href="#or-tarro" x="420" y="400" width="56" height="94" style="color:{{ c_sal }}"/>
        <use href="#or-tarro" x="140" y="430" width="66" height="110" style="color:{{ c_pimienta }}"/>
        <use href="#or-tarro" x="300" y="436" width="64" height="106" transform="rotate(84 332 489)" style="color:{{ c_hierbas }}"/>
        <use href="#or-tarro" x="456" y="432" width="64" height="108" transform="rotate(-6 488 540)" style="color:{{ c_canela }}"/>
        <use href="#or-tarro" x="368" y="440" width="58" height="98" style="color:{{ c_curcuma }}"/>
      {%- else -%}
        {%- comment -%} balda de arriba: todo en un solo especiero {%- endcomment -%}
        <use href="#or-carrusel" x="150" y="40" width="300" height="300"/>
        {%- comment -%} balda de abajo: espacio libre {%- endcomment -%}
        <rect x="104" y="500" width="150" height="16" rx="8" style="fill:#fff;stroke:var(--or-texto);stroke-width:3"/>
        <rect x="112" y="484" width="134" height="16" rx="8" style="fill:#fff;stroke:var(--or-texto);stroke-width:3"/>
        <rect x="120" y="468" width="118" height="16" rx="8" style="fill:#fff;stroke:var(--or-texto);stroke-width:3"/>
        <path d="M360 470 h120 a10 10 0 0 1 10 10 v30 a36 36 0 0 1 -36 36 h-68 a36 36 0 0 1 -36 -36 v-30 a10 10 0 0 1 10 -10 z" style="fill:var(--or-salvia);stroke:var(--or-texto);stroke-width:3"/>
        <path d="M490 486 h12 a14 14 0 0 1 0 28 h-12" style="fill:none;stroke:var(--or-texto);stroke-width:3"/>
      {%- endif -%}

    {%- when 'encimera' -%}
      <rect x="0" y="0" width="600" height="600" style="fill:var(--or-fondo-alt)"/>
      <rect x="0" y="470" width="600" height="130" style="fill:#D8C7A9"/>
      <rect x="0" y="462" width="600" height="14" style="fill:#C9B593"/>
      <path d="M78 352 L58 214" style="fill:none;stroke:#B07A4A;stroke-width:8;stroke-linecap:round"/>
      <ellipse cx="55" cy="196" rx="15" ry="24" transform="rotate(-8 55 196)" style="fill:#B07A4A"/>
      <path d="M100 352 L104 196" style="fill:none;stroke:#9B6A3E;stroke-width:8;stroke-linecap:round"/>
      <rect x="88" y="150" width="32" height="50" rx="6" style="fill:#9B6A3E"/>
      <path d="M122 352 L148 222" style="fill:none;stroke:#B07A4A;stroke-width:8;stroke-linecap:round"/>
      <ellipse cx="152" cy="206" rx="14" ry="22" transform="rotate(12 152 206)" style="fill:#B07A4A"/>
      <rect x="44" y="330" width="112" height="132" rx="16" style="fill:#fff;stroke:var(--or-texto);stroke-width:3"/>
      <rect x="44" y="372" width="112" height="16" style="fill:var(--or-acento);opacity:.85"/>
      <rect x="452" y="330" width="110" height="132" rx="16" style="fill:var(--or-salvia);stroke:var(--or-texto);stroke-width:3"/>
      <path d="M470 330 c0 -40 20 -60 40 -80 M510 330 c0 -50 -10 -70 -26 -96 M530 330 c4 -36 16 -56 30 -70" style="fill:none;stroke:#6E7F55;stroke-width:5;stroke-linecap:round"/>
      <use href="#or-carrusel" x="110" y="90" width="380" height="380"/>

    {%- else -%}
      <use href="#or-carrusel" x="0" y="0" width="600" height="600"/>
      <path class="or-ilu__flecha" d="M120 196 A 196 52 0 0 1 480 196" style="fill:none;stroke:var(--or-acento);stroke-width:5;stroke-linecap:round;stroke-dasharray:2 14"/>
      <path d="M466 176 l18 22 -28 6" style="fill:none;stroke:var(--or-acento);stroke-width:5;stroke-linecap:round;stroke-linejoin:round"/>
  {%- endcase -%}
</svg>
