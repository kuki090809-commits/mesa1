{%- comment -%}
  Ordena: variables de diseño globales. Los valores salen de
  Personalizar → Configuración del tema → «Ordena · Colores de marca».
{%- endcomment -%}
<script>document.documentElement.classList.add('or-js');</script>
<style>
  :root {
    --or-fondo: {{ settings.or_fondo | default: '#F4EFE6' }};
    --or-fondo-alt: {{ settings.or_fondo_alt | default: '#EAE2D3' }};
    --or-texto: {{ settings.or_texto | default: '#1F2A22' }};
    --or-texto-rgb: {{ settings.or_texto | default: '#1F2A22' | color_to_rgb | remove: 'rgb(' | remove: ')' }};
    --or-acento: {{ settings.or_acento | default: '#C4502A' }};
    --or-acento-hover: {{ settings.or_acento | default: '#C4502A' | color_darken: 8 }};
    --or-acento-texto: {{ settings.or_acento_texto | default: '#FFFFFF' }};
    --or-oscuro: {{ settings.or_oscuro | default: '#1F2A22' }};
    --or-claro: {{ settings.or_claro | default: '#F4EFE6' }};
    --or-salvia: {{ settings.or_salvia | default: '#7D8C6A' }};
    --or-radio: {{ settings.or_radio | default: 20 }}px;
    --or-titulos: var(--font-heading-family);
    --or-cuerpo: var(--font-body-family);
  }
  {%- unless settings.or_animaciones -%}
    .or-reveal { opacity: 1 !important; transform: none !important; }
  {%- endunless -%}
</style>
