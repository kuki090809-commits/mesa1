{%- comment -%} Ordena: logo de texto con icono (se usa cuando no hay imagen de logo). {%- endcomment -%}
{%- assign tam = alto | default: 28 -%}
<span class="or-logo" style="--or-logo-tam: {{ tam }}px;">
  {%- if icono != false -%}
    <svg class="or-logo__icono" viewBox="0 0 48 48" aria-hidden="true" focusable="false">
      <circle cx="24" cy="24" r="21" fill="none" stroke="currentColor" stroke-width="3"/>
      <g class="or-logo__giro">
        <circle cx="24" cy="9.5" r="4.2" fill="var(--or-acento)"/>
        <circle cx="38.5" cy="24" r="4.2" fill="currentColor"/>
        <circle cx="24" cy="38.5" r="4.2" fill="currentColor"/>
        <circle cx="9.5" cy="24" r="4.2" fill="currentColor"/>
      </g>
      <circle cx="24" cy="24" r="4" fill="currentColor"/>
    </svg>
  {%- endif -%}
  <span class="or-logo__texto">{{ texto | default: shop.name | escape }}</span>
</span>
