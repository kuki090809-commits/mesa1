    "preguntas": {
      "type": "fd-faq",
      "blocks": {
        "q1": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Entre qué alturas se regula?",
            "respuesta": "<p>De 60 a 90 cm, para que se adapte a tu posición: junto al sofá, al sillón o a la cama.</p>"
          }
        },
        "q2": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Qué cabe encima?",
            "respuesta": "<p>La superficie mide 60 × 40 cm: suficiente para el portátil, una tablet, un libro y tus accesorios.</p>"
          }
        },
        "q3": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Es difícil de montar?",
            "respuesta": "<p>No. Incluye la tornillería necesaria y el montaje es sencillo: no lleva más de unos minutos.</p>"
          }
        },
        "q4": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Se puede mover fácilmente?",
            "respuesta": "<p>Sí. La base, de 57 × 40 cm, lleva ruedas para desplazarla con facilidad.</p>"
          }
        },
        "q5": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Cuánto tarda en llegar?",
            "respuesta": "<p>El envío es gratuito y tarda entre 5 y 7 días laborables desde que confirmas el pedido. Te mandamos el número de seguimiento por correo en cuanto sale.</p>"
          }
        },
        "q6": {
          "type": "pregunta",
          "settings": {
            "pregunta": "¿Y si no me convence?",
            "respuesta": "<p>Tienes 30 días desde que la recibes para pedir la devolución. Tienes todos los detalles en nuestra <a href=\"/pages/politica-de-devoluciones\">política de devoluciones</a>.</p>"
          }
        }
      },
