{%- comment -%} MAISON DUVAL: migas de pan para buscadores (BreadcrumbList) en producto, colección y páginas. {%- endcomment -%}
{%- if template.name == 'product' or template.name == 'collection' or template.name == 'page' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Inicio", "item": {{ request.origin | append: routes.root_url | json }} }
        {%- if template.name == 'product' -%}
          {%- if collection -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
            ,{ "@type": "ListItem", "position": 3, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
          {%- else -%}
            ,{ "@type": "ListItem", "position": 2, "name": {{ product.title | json }}, "item": {{ request.origin | append: product.url | json }} }
          {%- endif -%}
        {%- elsif template.name == 'collection' -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ collection.title | json }}, "item": {{ request.origin | append: collection.url | json }} }
        {%- else -%}
          ,{ "@type": "ListItem", "position": 2, "name": {{ page.title | json }}, "item": {{ request.origin | append: page.url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
