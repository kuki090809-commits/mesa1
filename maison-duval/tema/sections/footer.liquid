{%- comment -%} MAISON DUVAL: pie de página (sustituye al de Dawn en este tema). Menús editables en Contenido → Menús. {%- endcomment -%}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}
<footer class="md-footer color-{{ section.settings.color_scheme }}">
  <div class="md-contenedor md-footer__grid">
    <div class="md-footer__marca">
      <a href="{{ routes.root_url }}" class="md-footer__logo" aria-label="{{ section.settings.logo_texto | escape }} – inicio">
        {%- render 'md-logo', nombre: section.settings.logo_texto, subtitulo: section.settings.logo_subtitulo, tam: 28 -%}
      </a>
      {%- if section.settings.lema != blank -%}
        <p class="md-footer__lema">{{ section.settings.lema | escape }}</p>
      {%- endif -%}
      {%- render 'social-icons', class: 'md-footer__redes' -%}
    </div>
    {%- for i in (1..3) -%}
      {%- liquid
        assign k_menu = 'menu_' | append: i
        assign menu = section.settings[k_menu]
      -%}
      {%- if menu != blank and menu.links.size > 0 -%}
        <nav class="md-footer__col" aria-label="{{ menu.title | escape }}">
          <h2 class="md-footer__titulo">{{ menu.title | escape }}</h2>
          <ul class="md-footer__links" role="list">
            {%- for link in menu.links -%}
              <li><a href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ link.title | escape }}</a></li>
            {%- endfor -%}
          </ul>
        </nav>
      {%- endif -%}
    {%- endfor -%}
    <div class="md-footer__col">
      <h2 class="md-footer__titulo">{{ section.settings.contacto_titulo | escape }}</h2>
      <ul class="md-footer__links md-footer__contacto" role="list">
        {%- if section.settings.contacto_email != blank -%}
          <li>{%- render 'md-icono', nombre: 'correo' -%}<a href="mailto:{{ section.settings.contacto_email | escape }}">{{ section.settings.contacto_email | escape }}</a></li>
        {%- endif -%}
        {%- if section.settings.contacto_horario != blank -%}
          <li>{%- render 'md-icono', nombre: 'reloj' -%}<span>{{ section.settings.contacto_horario | escape }}</span></li>
        {%- endif -%}
        {%- if section.settings.contacto_pagina != blank -%}
          <li>{%- render 'md-icono', nombre: 'atencion' -%}<a href="{{ section.settings.contacto_pagina.url }}">{{ section.settings.contacto_enlace_texto | escape }}</a></li>
        {%- endif -%}
      </ul>
    </div>
  </div>
  <div class="md-contenedor md-footer__barra">
    <p class="md-footer__copy">© {{ 'now' | date: '%Y' }} {{ section.settings.copyright | escape }}</p>
    <ul class="md-footer__mini" role="list">
      {%- if section.settings.cookies_texto != blank -%}
        <li><a href="{{ settings.md_cookies_pagina.url | default: routes.root_url }}" data-md-cookies-abrir>{{ section.settings.cookies_texto | escape }}</a></li>
      {%- endif -%}
    </ul>
    {%- if section.settings.mostrar_pagos and shop.enabled_payment_types.size > 0 -%}
      <ul class="list-payment md-footer__pagos" role="list">
        <li class="visually-hidden">Métodos de pago aceptados</li>
        {%- for type in shop.enabled_payment_types -%}
          <li class="list-payment__item">{{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% style %}
  .md-footer { border-top: 1px solid rgba(81, 72, 63, 0.12); }
  .md-footer__grid { display: grid; grid-template-columns: minmax(0, 1.5fr) repeat(4, minmax(0, 1fr)); gap: 4rem; padding-block: 6.4rem 4.8rem; }
  .md-footer__logo { display: inline-block; color: inherit; text-decoration: none; }
  .md-footer__lema { max-width: 30rem; margin: 2rem 0 0; font-family: var(--font-heading-family); font-size: 1.85rem; line-height: 1.45; }
  .md-footer__redes { justify-content: flex-start; margin: 2rem 0 0 -1.2rem; }
  .md-footer__titulo { margin: 0 0 1.8rem; font-family: var(--font-body-family); font-size: 1.15rem; font-weight: 500; letter-spacing: 0.24em; text-transform: uppercase; }
  .md-footer__links { display: grid; gap: 1.1rem; margin: 0; padding: 0; list-style: none; font-size: 1.45rem; }
  .md-footer__links a { color: inherit; text-decoration: none; }
  .md-footer__links a:hover { text-decoration: underline; text-underline-offset: 0.3rem; }
  .md-footer__contacto li { display: flex; gap: 1rem; align-items: center; }
  .md-footer__contacto .md-icono { width: 1.8rem; height: 1.8rem; flex: none; }
  .md-footer__barra { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1.6rem; padding-block: 2.4rem; border-top: 1px solid rgba(81, 72, 63, 0.14); font-size: 1.3rem; }
  .md-footer__copy { margin: 0; }
  .md-footer__mini { display: flex; gap: 2rem; margin: 0; padding: 0; list-style: none; }
  .md-footer__mini a { color: inherit; }
  .md-footer__pagos { margin: 0; }
  @media screen and (max-width: 989px) {
    .md-footer__grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .md-footer__marca { grid-column: 1 / -1; }
  }
  @media screen and (max-width: 749px) {
    .md-footer__grid { grid-template-columns: minmax(0, 1fr); gap: 3.2rem; padding-block: 4.8rem 3.2rem; }
    .md-footer__barra { flex-direction: column; align-items: flex-start; }
  }
{% endstyle %}

{% schema %}
{
  "name": "MD – Pie de página",
  "tag": "div",
  "settings": [
    { "type": "text", "id": "logo_texto", "label": "Logo: nombre", "default": "MAISON DUVAL" },
    { "type": "text", "id": "logo_subtitulo", "label": "Logo: subtítulo", "default": "TRAVEL ESSENTIALS" },
    { "type": "text", "id": "lema", "label": "Eslogan", "default": "Viaja ligero. Vive más." },
    { "type": "paragraph", "content": "Las redes sociales se añaden en Configuración del tema → Redes sociales." },
    { "type": "link_list", "id": "menu_1", "label": "Menú columna 1" },
    { "type": "link_list", "id": "menu_2", "label": "Menú columna 2" },
    { "type": "link_list", "id": "menu_3", "label": "Menú columna 3" },
    { "type": "header", "content": "Contacto" },
    { "type": "text", "id": "contacto_titulo", "label": "Título", "default": "Contacto" },
    { "type": "text", "id": "contacto_email", "label": "Correo de atención al cliente" },
    { "type": "text", "id": "contacto_horario", "label": "Horario de atención" },
    { "type": "page", "id": "contacto_pagina", "label": "Página de contacto" },
    { "type": "text", "id": "contacto_enlace_texto", "label": "Texto del enlace a contacto", "default": "Escríbenos" },
    { "type": "header", "content": "Barra inferior" },
    { "type": "text", "id": "copyright", "label": "Nombre junto al ©", "default": "MAISON DUVAL" },
    { "type": "text", "id": "cookies_texto", "label": "Enlace para cambiar las preferencias de cookies", "default": "Preferencias de cookies" },
    { "type": "checkbox", "id": "mostrar_pagos", "label": "Mostrar métodos de pago", "default": true },
    { "type": "color_scheme", "id": "color_scheme", "label": "Colores", "default": "scheme-2" }
  ]
}
{% endschema %}
