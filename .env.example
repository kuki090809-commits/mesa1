# Dominio de tu tienda Shopify (sin protocolo), ej: your-store.myshopify.com
SHOPIFY_STORE_DOMAIN=0tp1ts-pj.myshopify.com

# Token de acceso de la Storefront API.
#
# Por seguridad, este token NO se puede generar automáticamente con
# herramientas de IA. Créalo tú mismo en unos minutos:
#   1. Ve al admin de Shopify -> Configuración -> Apps y canales de venta.
#   2. Pulsa "Desarrollar apps" -> "Crear una app" (ponle un nombre, ej.
#      "FlexiDesk Storefront").
#   3. En "Configuración" -> "Storefront API", pulsa "Configurar" y activa
#      al menos estos scopes:
#        unauthenticated_read_product_listings
#        unauthenticated_read_product_inventory
#        unauthenticated_read_product_tags
#        unauthenticated_write_checkouts
#        unauthenticated_read_checkouts
#      (o simplemente activa todos los de lectura de producto/carrito).
#   4. Pulsa "Instalar app".
#   5. En la pestaña "Credenciales de API", copia el "Storefront API access token".
SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# Versión de la Storefront API a usar.
SHOPIFY_STOREFRONT_API_VERSION=2024-10
